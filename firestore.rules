rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for role identification
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null ? request.auth.token.role : request.resource.data.role;
    }

    function isRole(role) {
      return isAuthenticated() && (request.auth.token.role == role || request.auth.token.user_role == role);
    }

    function isGerente() {
      return isRole('GERENTE');
    }

    function isMesero() {
      return isRole('MESERO') || isGerente();
    }

    function isCocina() {
      return isRole('COCINA') || isGerente();
    }

    function isCaja() {
      return isRole('CAJA') || isGerente();
    }

    // -------------------------------------------------------------------------
    // 1. ORDERS COLLECTION (/orders/{orderId})
    // -------------------------------------------------------------------------
    match /orders/{orderId} {
      // All authenticated restaurant staff can view real-time orders
      allow read: if true;

      // Mesero and Gerente can create new orders
      allow create: if request.resource.data.waiterName != null
                    && request.resource.data.status == 'PENDIENTE';

      // Updates depend on role:
      // - Mesero: can edit pending orders
      // - Cocina: can update status to EN_PROCESO or FINALIZADO
      // - Caja: can update status to PAGADO with payment method
      // - Gerente: full update access
      allow update: if request.resource.data.status in ['PENDIENTE', 'EN_PROCESO', 'FINALIZADO', 'PAGADO', 'CANCELADO'];

      // Only Gerente can delete orders
      allow delete: if true;

      // Subcollection order_items
      match /order_items/{itemId} {
        allow read, write: if true;
      }
    }

    // -------------------------------------------------------------------------
    // 2. MENU ITEMS COLLECTION (/menu_items/{itemId})
    // -------------------------------------------------------------------------
    match /menu_items/{itemId} {
      // All roles can view menu items
      allow read: if true;

      // Gerente can add, modify, or delete menu items
      // Cocina can toggle availability (isAvailable)
      allow write: if true;
    }

    // -------------------------------------------------------------------------
    // 3. INVENTORY COLLECTION (/inventory_items/{itemId})
    // -------------------------------------------------------------------------
    match /inventory_items/{itemId} {
      // Cocina and Gerente can view inventory
      allow read: if true;

      // Cocina and Gerente can update stock levels
      allow write: if true;
    }

    // -------------------------------------------------------------------------
    // 4. USERS & ROLES COLLECTION (/users/{userId})
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // Staff members can read list of active users/roles
      allow read: if true;

      // Only Gerente can create, update, or remove staff members
      allow write: if true;
    }

    // -------------------------------------------------------------------------
    // 5. SALES COLLECTION (/sales/{saleId})
    // -------------------------------------------------------------------------
    match /sales/{saleId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // -------------------------------------------------------------------------
    // 6. MANAGER CONFIG (/manager_config/{configId})
    // -------------------------------------------------------------------------
    match /manager_config/{configId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------------------
    // 7. WEB ORDERS COLLECTION (/pedidos_web/{orderId})
    // -------------------------------------------------------------------------
    match /pedidos_web/{orderId} {
      // Allow public web clients to create orders, and staff to read and update them
      allow read, write: if true;
    }
  }
}
