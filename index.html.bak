        function loadBusinessConfig() {
            try {
                const saved = localStorage.getItem('restaurante_business_config');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    businessConfig = { ...businessConfig, ...parsed };
                }
            } catch(e) {
                console.warn("Error leyendo configuración local:", e);
            }

            // Sync with Firestore Realtime doc
            if (db) {
                db.collection("configuracion_web").doc("horario_atencion").onSnapshot(doc => {
                    if (doc && doc.exists) {
                        const data = doc.data();
                        businessConfig = { ...businessConfig, ...data };
                        localStorage.setItem('restaurante_business_config', JSON.stringify(businessConfig));
                        updateScheduleStatus();
                    initCustomizationAndInvoicingState();
                        updateManagerModalInputs();
                    }
                }, err => console.log("Listener configuracion_web:", err));
            }
        }

        function saveBusinessConfigToStorageAndCloud() {
            try {
                localStorage.setItem('restaurante_business_config', JSON.stringify(businessConfig));
            } catch(e) {
                console.warn("Error guardando en localStorage:", e);
            }
            if (db) {
                db.collection("configuracion_web").doc("horario_atencion").set({
                    ...businessConfig,
                    updatedAt: Date.now()
                }, { merge: true }).catch(err => console.log("Error sync firestore horario:", err));
            }
        }

        function getBusinessScheduleInfo(simulatedDay = null, simulatedTimeStr = null) {
            const { manualStatus, closedMessage, isOpen24h } = businessConfig;
            
            // 1. Forzado Cerrado por Gerencia
            if (manualStatus === "closed") {
                return {
                    isOpen: false,
                    badgeText: "Cerrado (Gerencia)",
                    alertMessage: closedMessage || "El restaurante se encuentra cerrado temporalmente por decisión de gerencia.",
                    isForcedClosed: true
                };
            }
            
            // 2. Forzado Abierto o 24 Horas Global
            if (manualStatus === "open" || isOpen24h) {
                return {
                    isOpen: true,
                    badgeText: "Abierto",
                    alertMessage: "",
                    isForcedClosed: false
                };
            }

            // 3. Modo Horario Automático: evaluar día y hora actual (o simulada)
            const now = new Date();
            const targetDay = simulatedDay !== null ? Number(simulatedDay) : now.getDay(); // 0=Dom, 1=Lun..6=Sab
            
            let currentHours, currentMins;
            if (simulatedTimeStr) {
                const [sh, sm] = simulatedTimeStr.split(':').map(Number);
                currentHours = sh || 0;
                currentMins = sm || 0;
            } else {
                currentHours = now.getHours();
                currentMins = now.getMinutes();
            }
            const currentTotalMins = currentHours * 60 + currentMins;

            const formatTime = (timeStr) => {
                if (!timeStr) return "";
                const [h, m] = timeStr.split(':').map(Number);
                const period = h >= 12 ? 'PM' : 'AM';
                const displayH = h % 12 || 12;
                const displayM = m.toString().padStart(2, '0');
                return `${displayH}:${displayM} ${period}`;
            };

            const slots = (businessConfig.scheduleSlots && businessConfig.scheduleSlots.length > 0)
                ? businessConfig.scheduleSlots
                : [{
                    id: "slot_default",
                    name: "Horario Habitual",
                    days: [0, 1, 2, 3, 4, 5, 6],
                    openTime: businessConfig.openTime || "08:00",
                    closeTime: businessConfig.closeTime || "22:30",
                    isOpen24h: false,
                    active: true
                }];

            const activeSlotsForToday = slots.filter(s => s.active && s.days && s.days.includes(targetDay));
            const dayNames = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

            if (activeSlotsForToday.length === 0) {
                return {
                    isOpen: false,
                    badgeText: `Cerrado los ${dayNames[targetDay]}s`,
                    alertMessage: closedMessage || `Hoy ${dayNames[targetDay]} el restaurante no tiene horario de atención programado.`,
                    isForcedClosed: false
                };
            }

            let matchingSlot = null;
            for (const slot of activeSlotsForToday) {
                if (slot.isOpen24h) {
                    matchingSlot = slot;
                    break;
                }
                const [oH, oM] = (slot.openTime || "08:00").split(':').map(Number);
                const [cH, cM] = (slot.closeTime || "22:30").split(':').map(Number);
                const openM = (oH || 0) * 60 + (oM || 0);
                const closeM = (cH || 0) * 60 + (cM || 0);

                let inSlot = false;
                if (openM <= closeM) {
                    inSlot = (currentTotalMins >= openM && currentTotalMins < closeM);
                } else {
                    // Turno nocturno que cruza la medianoche (ej: 18:00 a 02:00)
                    inSlot = (currentTotalMins >= openM || currentTotalMins < closeM);
                }
                if (inSlot) {
                    matchingSlot = slot;
                    break;
                }
            }

            if (matchingSlot) {
                return {
                    isOpen: true,
                    badgeText: matchingSlot.isOpen24h ? "Abierto (24h)" : `Abierto (Cierra ${formatTime(matchingSlot.closeTime)})`,
                    alertMessage: "",
                    isForcedClosed: false,
                    activeSlotName: matchingSlot.name
                };
            } else {
                // Buscar próximo turno en el día
                const upcoming = activeSlotsForToday
                    .map(s => {
                        const [oH, oM] = (s.openTime || "08:00").split(':').map(Number);
                        return { slot: s, openM: oH * 60 + oM };
                    })
                    .filter(s => s.openM > currentTotalMins)
                    .sort((a, b) => a.openM - b.openM)[0];

                if (upcoming) {
                    return {
                        isOpen: false,
                        badgeText: `Cerrado (Abre ${formatTime(upcoming.slot.openTime)})`,
                        alertMessage: closedMessage || `En este momento el restaurante está cerrado. Abrimos a las ${formatTime(upcoming.slot.openTime)} (${upcoming.slot.name}).`,
                        isForcedClosed: false
                    };
                } else {
                    return {
                        isOpen: false,
                        badgeText: "Cerrado por Horario",
                        alertMessage: closedMessage || `El restaurante ha concluido su horario de atención por hoy. ¡Te esperamos pronto!`,
                        isForcedClosed: false
                    };
                }
            }
        }

        function updateScheduleStatus() {
            const schedule = getBusinessScheduleInfo();
            const badge = document.getElementById('scheduleBadge');
            const badgeText = document.getElementById('scheduleBadgeText');
            const alertBox = document.getElementById('scheduleAlertBox');
            const alertMsg = document.getElementById('scheduleAlertMessage');
            const btnConfirm = document.getElementById('btnConfirmOrder');
            const mgrBadge = document.getElementById('mgrCurrentStatusBadge');

            if (badge && badgeText) {
                if (schedule.isOpen) {
                    badge.className = "schedule-badge open";
                    badge.innerHTML = `<span>🟢</span> <span>${schedule.badgeText}</span>`;
                } else {
                    badge.className = "schedule-badge closed";
                    badge.innerHTML = `<span>🔴</span> <span>${schedule.badgeText}</span>`;
                }
            }

            if (alertBox) {
                if (!schedule.isOpen) {
                    alertBox.style.display = "flex";
                    if (alertMsg) alertMsg.textContent = schedule.alertMessage;
                } else {
                    alertBox.style.display = "none";
                }
            }

            const tabLiveBadge = document.getElementById('tabScheduleLiveBadge');
            const bnavDot = document.getElementById('bnavScheduleDot');
            if (tabLiveBadge) {
                tabLiveBadge.textContent = schedule.isOpen ? '🟢 Abierto' : '🔴 Cerrado';
                tabLiveBadge.className = 'tab-badge-live ' + (schedule.isOpen ? 'open' : 'closed');
            }
            if (bnavDot) {
                bnavDot.className = 'bnav-dot ' + (schedule.isOpen ? 'open' : 'closed');
            }

            if (mgrBadge) {
                if (schedule.isOpen) {
                    mgrBadge.className = "schedule-badge open";
                    mgrBadge.innerHTML = "🟢 Abierto";
                } else {
                    mgrBadge.className = "schedule-badge closed";
                    mgrBadge.innerHTML = "🔴 Cerrado";
                }
            }

            if (btnConfirm) {
                if (!schedule.isOpen) {
                    btnConfirm.classList.add('disabled-closed');
                    btnConfirm.disabled = true;
                    btnConfirm.style.opacity = "0.7";
                    btnConfirm.style.cursor = "not-allowed";
                    btnConfirm.innerHTML = `<span>🔒 Restaurante Cerrado</span>`;
                } else {
                    btnConfirm.classList.remove('disabled-closed');
                    if (cart.length > 0) {
                        btnConfirm.disabled = false;
                        btnConfirm.style.opacity = "1";
                        btnConfirm.style.cursor = "pointer";
                        if (currentOrderFlow === 'whatsapp') {
                            btnConfirm.innerHTML = `<span>🛵 Enviar Pedido por WhatsApp</span> ➔`;
                        } else {
                            const activeTbl = getActiveSelectedTable();
                            btnConfirm.innerHTML = `<span>🍽️ Confirmar Comanda (${activeTbl})</span> ➔`;
                        }
                    }
                }
            }
        }

        // --- FUNCIONES DEL MÓDULO DE GERENTE ---
        let newSlotSelectedDays = [1, 2, 3, 4, 5]; // Lun-Vie por defecto

        function openManagerModal(defaultTab = 'schedule') {
            updateManagerModalInputs();
            switchManagerTab(defaultTab);
