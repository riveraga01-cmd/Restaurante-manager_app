            const subtotal = 85.00;
            const taxAmt = (subtotal * (taxRate / 100));
            const tipAmt = (subtotal * (tipRate / 100));
            const total = subtotal + tipAmt;

            ticketBox.innerHTML = `
                <div style="text-align: center; border-bottom: 1px dashed #CBD5E1; padding-bottom: 10px; margin-bottom: 10px;">
                    <div style="font-weight: 800; font-size: 14px; text-transform: uppercase;">${bName}</div>
                    <div style="font-size: 11px; color: #64748B;">NIT / ID: ${bTax}</div>
                    <div style="font-size: 11px; color: #64748B;">${bAddr}</div>
                    <div style="font-size: 11px; color: #64748B;">Tel: ${bPhone}</div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 11px; color: #64748B; margin-bottom: 8px;">
                    <span>DOC: FAC-2026-0042</span>
                    <span>${dateStr}</span>
                </div>
                <div style="border-bottom: 1px dashed #CBD5E1; padding-bottom: 6px; margin-bottom: 8px;">
                    <div style="display: flex; justify-content: space-between; font-weight: 700; margin-bottom: 4px;">
                        <span>1x Plato Típico Especial</span>
                        <span>Q55.00</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-weight: 700;">
                        <span>2x Bebidas Naturales</span>
                        <span>Q30.00</span>
                    </div>
                </div>
                <div style="display: flex; flex-direction: column; gap: 3px; font-size: 11.5px;">
                    <div style="display: flex; justify-content: space-between;">
                        <span>Subtotal:</span>
                        <span>Q${subtotal.toFixed(2)}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; color: #64748B;">
                        <span>IVA (${taxRate}% incl.):</span>
                        <span>Q${taxAmt.toFixed(2)}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; color: #64748B;">
                        <span>Propina sugerida (${tipRate}%):</span>
                        <span>Q${tipAmt.toFixed(2)}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; font-weight: 800; font-size: 13.5px; border-top: 1px solid #1E293B; padding-top: 5px; margin-top: 4px;">
                        <span>TOTAL:</span>
                        <span>Q${total.toFixed(2)}</span>
                    </div>
                </div>
                <div style="text-align: center; margin-top: 12px; font-size: 10.5px; color: #64748B;">
                    *** ¡Gracias por su preferencia! ***
                </div>
            `;
        }

