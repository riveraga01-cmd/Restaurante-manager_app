            if (backdrop) backdrop.style.display = 'flex';
        }

        function closeManagerModal() {
            const backdrop = document.getElementById('managerModalBackdrop');
            if (backdrop) backdrop.style.display = 'none';
        }

        
        let currentAppView = 'menu';

        function switchAppView(viewName) {
            currentAppView = viewName;
            const views = {
                menu: document.getElementById('appViewMenu'),
                customization: document.getElementById('appViewCustomization'),
                schedule: document.getElementById('appViewSchedule'),
                invoicing: document.getElementById('appViewInvoicing')
            };

            const topTabs = {
                menu: document.getElementById('tabNavMenu'),
                customization: document.getElementById('tabNavCustomization'),
                schedule: document.getElementById('tabNavSchedule'),
                invoicing: document.getElementById('tabNavInvoicing')
            };

            const bnavTabs = {
                menu: document.getElementById('bnavMenu'),
                customization: document.getElementById('bnavCustomization'),
                schedule: document.getElementById('bnavSchedule'),
                invoicing: document.getElementById('bnavInvoicing')
            };

            closeManagerModal();

            // Toggle views
            Object.keys(views).forEach(key => {
                if (views[key]) {
                    views[key].style.display = (key === viewName) ? 'block' : 'none';
                }
                if (topTabs[key]) {
                    topTabs[key].classList.toggle('active', key === viewName);
                }
                if (bnavTabs[key]) {
                    bnavTabs[key].classList.toggle('active', key === viewName);
                }
            });

            if (viewName === 'customization') {
                updateCustomizationInputs();
            } else if (viewName === 'schedule') {
                updateManagerModalInputs();
                renderManagerScheduleSlots();
                renderManagerCustomNotices();
                updateManagerLiveCalculation();
                updateClosedTabPreview();
                runScheduleSimulation();
            } else if (viewName === 'invoicing') {
                updateInvoicingInputs();
                renderInvoiceTicketPreview();
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        
        function switchManagerTab(tabKey) {
            if (tabKey === 'closed' || tabKey === 'horario' || tabKey === 'estado') tabKey = 'schedule';
            const tabs = ['customization', 'schedule', 'invoicing', 'whatsapp', 'tables', 'products', 'orders'];
            tabs.forEach(t => {
                const btn = document.getElementById(`btnMgrTab${t.charAt(0).toUpperCase() + t.slice(1)}`);
                const pane = document.getElementById(`mgrPane${t.charAt(0).toUpperCase() + t.slice(1)}`);
                if (btn) btn.classList.toggle('active', t === tabKey);
                if (pane) pane.classList.toggle('active', t === tabKey);
            });

            if (tabKey === 'customization') {
                updateCustomizationInputs();
            } else if (tabKey === 'schedule') {
                renderManagerScheduleSlots();
                updateManagerLiveCalculation();
                renderManagerCustomNotices();
                updateClosedTabPreview();
                runScheduleSimulation();
            } else if (tabKey === 'invoicing') {
                updateInvoicingInputs();
                renderInvoiceTicketPreview();
            } else if (tabKey === 'products') {
                renderManagerDishesList();
            } else if (tabKey === 'orders') {
                renderManagerOrdersList();
            } else if (tabKey === 'tables') {
                updateManagerQrLinkPreview();
            }
        }
        
        function updateClosedTabPreview() {
            const msgInput = document.getElementById('mgrInputClosedMessage');
            const previewEl = document.getElementById('mgrPreviewClosedText');
            if (previewEl && msgInput) {
                previewEl.textContent = msgInput.value || "Nuestro horario de atención es de 8:00 AM a 10:30 PM. En este momento el restaurante está cerrado. ¡Te esperamos pronto!";
            }
        }

        function setManagerStatusOption(opt) {
            businessConfig.manualStatus = opt;
            ['Open', 'Auto', 'Closed'].forEach(o => {
                const b = document.getElementById(`btnMgrStatus${o}`);
                if (b) b.classList.remove('active-open', 'active-auto', 'active-closed');
            });
            const activeBtn = document.getElementById(`btnMgrStatus${opt.charAt(0).toUpperCase() + opt.slice(1)}`);
            if (activeBtn) {
                activeBtn.classList.add(`active-${opt}`);
            }
            saveBusinessConfigToStorageAndCloud();
            updateScheduleStatus();
            updateManagerLiveCalculation();
            runScheduleSimulation();
            updateClosedTabPreview();
        }

        function toggleMgr24h(checked) {
            businessConfig.isOpen24h = checked;
            saveBusinessConfigToStorageAndCloud();
            updateScheduleStatus();
            updateManagerLiveCalculation();
            runScheduleSimulation();
        }

        function updateManagerLiveCalculation() {
            const clockEl = document.getElementById('mgrLiveClockTime');
            const dayEl = document.getElementById('mgrLiveClockDay');
            const calcEl = document.getElementById('mgrLiveCalculatedStatus');
            const badgeEl = document.getElementById('mgrCurrentStatusBadge');

            const now = new Date();
            const currentHours = String(now.getHours()).padStart(2, '0');
            const currentMins = String(now.getMinutes()).padStart(2, '0');
            const currentTimeStr = `${currentHours}:${currentMins}`;
            const dayNames = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
            const currentDayName = dayNames[now.getDay()];

            if (clockEl) clockEl.textContent = currentTimeStr;
            if (dayEl) dayEl.textContent = `(${currentDayName})`;

            const schedule = getBusinessScheduleInfo();

            if (calcEl) {
                if (schedule.isOpen) {
                    calcEl.innerHTML = `<span style="color: #15803D;">🟢 <b>Abierto</b> (${schedule.badgeText})</span>`;
                } else {
                    calcEl.innerHTML = `<span style="color: #B91C1C;">🔴 <b>Cerrado</b> (${schedule.badgeText})</span>`;
                }
            }

            if (badgeEl) {
                badgeEl.className = `schedule-badge ${schedule.isOpen ? 'open' : 'closed'}`;
                badgeEl.textContent = schedule.isOpen ? '🟢 Abierto' : '🔴 Cerrado';
            }

            updateClosedTabPreview();
        }

        // --- GESTIÓN INTERACTIVA DE HORARIOS Y JORNADAS (Añadir, Modificar, Eliminar) ---
        function toggleAddScheduleForm(show = null) {
            const form = document.getElementById('mgrAddScheduleForm');
            const btn = document.getElementById('btnToggleAddScheduleForm');
            if (!form) return;
            // Si se llama desde otra pestaña, cambiar a la pestaña de turnos
            const activeTabBtn = document.querySelector('.manager-tab-btn.active');
            if (show === true && activeTabBtn && activeTabBtn.id !== 'btnMgrTabSchedule') {
                switchManagerTab('schedule');
            }
            const isVisible = form.style.display !== 'none';
            const nextState = show !== null ? show : !isVisible;
            form.style.display = nextState ? 'block' : 'none';
            if (btn) {
                btn.innerHTML = nextState 
                    ? '<span>✕</span> <span>Cerrar Formulario</span>' 
                    : '<span>➕</span> <span>Añadir Horario / Turno</span>';
            }
            if (nextState) {
                renderNewSlotDayChips();
                const nameInput = document.getElementById('mgrNewSlotName');
                if (nameInput) setTimeout(() => nameInput.focus(), 150);
            }
        }

        function renderNewSlotDayChips() {
            const container = document.getElementById('mgrNewSlotDaysContainer');
            if (!container) return;
            const dayDefs = [
                { day: 1, label: 'L', name: 'Lunes' },
                { day: 2, label: 'M', name: 'Martes' },
                { day: 3, label: 'M', name: 'Miércoles' },
                { day: 4, label: 'J', name: 'Jueves' },
                { day: 5, label: 'V', name: 'Viernes' },
                { day: 6, label: 'S', name: 'Sábado' },
                { day: 0, label: 'D', name: 'Domingo' }
            ];
            container.innerHTML = dayDefs.map(d => `
                <button type="button" class="mgr-day-chip ${newSlotSelectedDays.includes(d.day) ? 'active' : ''}" 
                        onclick="toggleNewSlotDay(${d.day})" title="${d.name}">
                    ${d.label}
                </button>
            `).join('');
        }

        function toggleNewSlotDay(dayNum) {
            if (newSlotSelectedDays.includes(dayNum)) {
                if (newSlotSelectedDays.length > 1) {
                    newSlotSelectedDays = newSlotSelectedDays.filter(d => d !== dayNum);
                } else {
                    showLiveToast("⚠️ Días Requeridos", "Debe seleccionarse al menos un día.", "warning", 2500);
                }
            } else {
                newSlotSelectedDays.push(dayNum);
            }
            renderNewSlotDayChips();
        }

        function presetNewSlotDays(type) {
            if (type === 'weekdays') newSlotSelectedDays = [1, 2, 3, 4, 5];
            else if (type === 'weekends') newSlotSelectedDays = [6, 0];
            else if (type === 'all') newSlotSelectedDays = [0, 1, 2, 3, 4, 5, 6];
            renderNewSlotDayChips();
        }

        function toggleNewSlot24h(checked) {
            const openInput = document.getElementById('mgrNewSlotOpenTime');
            const closeInput = document.getElementById('mgrNewSlotCloseTime');
            if (openInput) openInput.disabled = checked;
            if (closeInput) closeInput.disabled = checked;
        }

        function saveNewScheduleSlot() {
            const nameInput = document.getElementById('mgrNewSlotName');
            const openInput = document.getElementById('mgrNewSlotOpenTime');
            const closeInput = document.getElementById('mgrNewSlotCloseTime');
            const chk24 = document.getElementById('mgrNewSlot24h');

            const name = nameInput ? nameInput.value.trim() : "";
            if (!name) {
                showLiveToast("⚠️ Nombre Requerido", "Ingresa un nombre para este horario (ej: Turno Almuerzo, Fin de Semana).", "warning", 3000);
                if (nameInput) nameInput.focus();
                return;
            }

            if (!newSlotSelectedDays || newSlotSelectedDays.length === 0) {
                showLiveToast("⚠️ Días Requeridos", "Selecciona al menos un día para este horario.", "warning", 3000);
                return;
            }

            if (!businessConfig.scheduleSlots) businessConfig.scheduleSlots = [];

            const newSlot = {
                id: "slot_" + Date.now(),
                name: name,
                days: [...newSlotSelectedDays].sort((a,b) => (a===0?7:a) - (b===0?7:b)),
                openTime: openInput ? openInput.value : "08:00",
                closeTime: closeInput ? closeInput.value : "22:30",
                isOpen24h: chk24 ? chk24.checked : false,
                active: true
            };

            businessConfig.scheduleSlots.push(newSlot);
            saveBusinessConfigToStorageAndCloud();
            renderManagerScheduleSlots();
            toggleAddScheduleForm(false);
            updateManagerLiveCalculation();
            updateScheduleStatus();
            runScheduleSimulation();

            if (nameInput) nameInput.value = "";
            if (chk24) chk24.checked = false;
            if (openInput) openInput.disabled = false;
            if (closeInput) closeInput.disabled = false;

            showLiveToast("✅ Horario Añadido", `Se ha creado el turno "${newSlot.name}".`, "success", 3500);
        }

        function renderManagerScheduleSlots() {
            const container1 = document.getElementById('mgrScheduleSlotsListContainer');
            const container2 = document.getElementById('mgrScheduleSlotsListContainerClosed');
            const countBadge1 = document.getElementById('mgrScheduleCountBadge');
            const countBadge2 = document.getElementById('mgrScheduleCountBadgeClosed');
            if (!container1 && !container2) return;

            if (!businessConfig.scheduleSlots) businessConfig.scheduleSlots = [];
            const slots = businessConfig.scheduleSlots;

            const activeCount = slots.filter(s => s.active).length;
            const badgeText = `${activeCount} activo${activeCount !== 1 ? 's' : ''} / ${slots.length} total`;
            if (countBadge1) countBadge1.textContent = badgeText;
            if (countBadge2) countBadge2.textContent = badgeText;

            if (slots.length === 0) {
                const emptyHtml = `
                    <div style="padding: 16px; text-align: center; background: #FFFFFF; border: 1.5px dashed #CBD5E1; border-radius: 10px; color: #64748B; font-size: 12px;">
                        <span>📅 No hay turnos configurados.</span><br>
                        <button type="button" onclick="toggleAddScheduleForm(true)" style="margin-top: 8px; background: #EEF2FF; border: 1px solid #6366F1; color: #4F46E5; padding: 6px 12px; border-radius: 6px; font-size: 11.5px; font-weight: 700; cursor: pointer;">
                            ➕ Añadir Primer Horario
                        </button>
                    </div>
                `;
                if (container1) container1.innerHTML = emptyHtml;
                if (container2) container2.innerHTML = emptyHtml;
                return;
            }

            const dayDefs = [
                { day: 1, label: 'L', name: 'Lunes' },
                { day: 2, label: 'M', name: 'Martes' },
                { day: 3, label: 'M', name: 'Miércoles' },
                { day: 4, label: 'J', name: 'Jueves' },
                { day: 5, label: 'V', name: 'Viernes' },
                { day: 6, label: 'S', name: 'Sábado' },
                { day: 0, label: 'D', name: 'Domingo' }
            ];

            const slotsHtml = slots.map((slot) => {
                const isInactive = !slot.active;
                const daysChips = dayDefs.map(d => {
                    const isDaySelected = slot.days && slot.days.includes(d.day);
                    return `
                        <button type="button" 
                                class="mgr-day-chip ${isDaySelected ? 'active' : ''}" 
                                onclick="toggleExistingSlotDay('${slot.id}', ${d.day})" 
                                title="Toca para alternar ${d.name}">
                            ${d.label}
                        </button>
                    `;
                }).join('');

                return `
                    <div class="mgr-schedule-card ${isInactive ? 'is-inactive' : ''}" id="card_slot_${slot.id}">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; margin-bottom: 8px; flex-wrap: wrap;">
                            <div style="flex: 1; min-width: 150px;">
                                <input type="text" value="${escapeHtml(slot.name)}" 
                                       onchange="modifyScheduleSlotField('${slot.id}', 'name', this.value)" 
                                       style="font-size: 12.5px; font-weight: 700; color: #1E293B; border: 1px solid transparent; border-bottom: 1px dashed #94A3B8; background: transparent; padding: 2px 4px; width: 100%; max-width: 280px; border-radius: 4px;"
                                       title="Clic para editar el nombre de la jornada">
                                <small style="font-size: 10.5px; color: #64748B; display: block; margin-top: 2px;">
                                    Toca los días para activar/desactivar este turno:
                                </small>
                            </div>

                            <div style="display: flex; align-items: center; gap: 6px;">
                                <button type="button" 
                                        onclick="toggleScheduleSlotActive('${slot.id}')" 
                                        style="padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; border: 1px solid ${slot.active ? '#86EFAC' : '#CBD5E1'}; background: ${slot.active ? '#DCFCE7' : '#F1F5F9'}; color: ${slot.active ? '#15803D' : '#64748B'}; cursor: pointer;"
                                        title="Alternar estado">
                                    ${slot.active ? '🟢 Activo' : '⚪ Pausado'}
                                </button>
                                <button type="button" class="mgr-action-btn-danger" onclick="deleteScheduleSlot('${slot.id}')" title="Eliminar este turno">
                                    🗑️ Eliminar
                                </button>
                            </div>
                        </div>

                        <!-- Chips de Días -->
                        <div style="display: flex; gap: 5px; margin-bottom: 8px; align-items: center; flex-wrap: wrap;">
                            <span style="font-size: 10.5px; font-weight: 600; color: #64748B; margin-right: 2px;">Días:</span>
                            ${daysChips}
                        </div>

                        <!-- Horas Open y Close modificables directamente -->
                        <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px; align-items: center; background: #F8FAFC; padding: 8px 10px; border-radius: 8px; border: 1px solid #E2E8F0;">
                            <div>
                                <span style="font-size: 10.5px; font-weight: 600; color: #475569; display: block; margin-bottom: 2px;">Hora Apertura:</span>
                                <input type="time" value="${slot.openTime || '08:00'}" 
                                       ${slot.isOpen24h ? 'disabled' : ''}
                                       onchange="modifyScheduleSlotField('${slot.id}', 'openTime', this.value)" 
                                       class="form-input" style="padding: 4px 6px; font-size: 11.5px; height: 32px;">
                            </div>
                            <div>
                                <span style="font-size: 10.5px; font-weight: 600; color: #475569; display: block; margin-bottom: 2px;">Hora Cierre:</span>
                                <input type="time" value="${slot.closeTime || '22:30'}" 
                                       ${slot.isOpen24h ? 'disabled' : ''}
                                       onchange="modifyScheduleSlotField('${slot.id}', 'closeTime', this.value)" 
                                       class="form-input" style="padding: 4px 6px; font-size: 11.5px; height: 32px;">
                            </div>
                            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding-top: 14px;">
                                <label style="font-size: 10.5px; color: #475569; display: flex; align-items: center; gap: 4px; cursor: pointer; margin: 0;">
                                    <input type="checkbox" ${slot.isOpen24h ? 'checked' : ''} onchange="modifyScheduleSlotField('${slot.id}', 'isOpen24h', this.checked)" style="width: 14px; height: 14px; cursor: pointer;">
                                    <span>24h</span>
                                </label>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            if (container1) container1.innerHTML = slotsHtml;
            if (container2) container2.innerHTML = slotsHtml;
        }

        function modifyScheduleSlotField(slotId, field, value) {
            const slot = (businessConfig.scheduleSlots || []).find(s => s.id === slotId);
            if (!slot) return;
            slot[field] = value;
            saveBusinessConfigToStorageAndCloud();
            updateManagerLiveCalculation();
            updateScheduleStatus();
            runScheduleSimulation();
            if (field === 'isOpen24h') {
                renderManagerScheduleSlots();
            }
            showLiveToast("✏️ Horario Modificado", `Se actualizó el campo "${field}" de la jornada.`, "info", 1800);
        }

        function toggleExistingSlotDay(slotId, dayNum) {
            const slot = (businessConfig.scheduleSlots || []).find(s => s.id === slotId);
            if (!slot) return;
            if (!slot.days) slot.days = [];
            if (slot.days.includes(dayNum)) {
                if (slot.days.length > 1) {
                    slot.days = slot.days.filter(d => d !== dayNum);
                } else {
                    showLiveToast("⚠️ Días Requeridos", "El horario debe aplicar al menos a un día.", "warning", 2000);
                    return;
                }
            } else {
                slot.days.push(dayNum);
                slot.days.sort((a,b) => (a===0?7:a) - (b===0?7:b));
            }
            saveBusinessConfigToStorageAndCloud();
            renderManagerScheduleSlots();
            updateManagerLiveCalculation();
            updateScheduleStatus();
            runScheduleSimulation();
            showLiveToast("✏️ Días Modificados", `Días actualizados para "${slot.name}".`, "info", 1800);
        }

        function toggleScheduleSlotActive(slotId) {
            const slot = (businessConfig.scheduleSlots || []).find(s => s.id === slotId);
            if (!slot) return;
            slot.active = !slot.active;
            saveBusinessConfigToStorageAndCloud();
            renderManagerScheduleSlots();
            updateManagerLiveCalculation();
            updateScheduleStatus();
            runScheduleSimulation();
            showLiveToast(slot.active ? "🟢 Horario Activado" : "⚪ Horario Pausado", `"${slot.name}" ahora está ${slot.active ? 'activo' : 'pausado'}.`, "info", 2000);
        }

        function deleteScheduleSlot(slotId) {
            const slot = (businessConfig.scheduleSlots || []).find(s => s.id === slotId);
            const slotName = slot ? slot.name : "este horario";
            if (!confirm(`¿Estás seguro de eliminar el horario "${slotName}"?`)) {
                return;
            }
            businessConfig.scheduleSlots = (businessConfig.scheduleSlots || []).filter(s => s.id !== slotId);
            saveBusinessConfigToStorageAndCloud();
            renderManagerScheduleSlots();
            updateManagerLiveCalculation();
            updateScheduleStatus();
            runScheduleSimulation();
            showLiveToast("🗑️ Horario Eliminado", `Se ha eliminado "${slotName}".`, "success", 2500);
        }

        // --- PLANTILLAS DE RESTAURANTE CERRADO ---
        function applyClosedTemplate(key) {
            const closedMsgInput = document.getElementById('mgrInputClosedMessage');
            if (!closedMsgInput) return;
            const templates = {
                'regular': "Nuestro horario de atención es de 8:00 AM a 10:30 PM. En este momento el restaurante está cerrado. ¡Te esperamos pronto!",
                'maintenance': "Estamos realizando labores de mantenimiento y mejoras en cocina. Volvemos en breve para atenderte con la mejor calidad.",
                'holiday': "Hoy nos encontramos cerrados por asueto festivo. Mañana reanudamos nuestro horario habitual con normalidad. ¡Gracias por tu preferencia!",
                'weather': "Servicio temporalmente pausado por condiciones climáticas. Agradecemos su comprensión y paciencia."
            };
            if (templates[key]) {
                closedMsgInput.value = templates[key];
                businessConfig.closedMessage = templates[key];
                saveBusinessConfigToStorageAndCloud();
                updateManagerLiveCalculation();
                updateScheduleStatus();
                updateClosedTabPreview();
                showLiveToast("📝 Plantilla Aplicada", "Mensaje de restaurante cerrado actualizado.", "info", 2000);
            }
        }

        // --- AVISOS ESPECIALES (Añadir, Modificar, Eliminar) ---
        function renderManagerCustomNotices() {
            const container = document.getElementById('mgrCustomNoticesContainer');
            if (!container) return;
            if (!businessConfig.customNotices) businessConfig.customNotices = [];
            const notices = businessConfig.customNotices;
            if (notices.length === 0) {
                container.innerHTML = `
                    <div style="font-size: 11.5px; color: #64748B; font-style: italic; padding: 4px 0;">
                        No hay avisos especiales configurados en este momento.
                    </div>
                `;
                return;
            }
            container.innerHTML = notices.map(n => `
                <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; background: #F8FAFC; border: 1px solid #E2E8F0; padding: 6px 10px; border-radius: 8px; margin-bottom: 6px;">
                    <div style="flex: 1;">
                        <strong style="font-size: 11.5px; color: #1E293B;">${escapeHtml(n.title || 'Aviso')}</strong>:
                        <span style="font-size: 11.5px; color: #475569;">${escapeHtml(n.message || '')}</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <button type="button" onclick="toggleCustomNoticeActive('${n.id}')" style="background: transparent; border: none; font-size: 14px; cursor: pointer;" title="Alternar activo/inactivo">
                            ${n.active ? '🟢' : '⚪'}
                        </button>
                        <button type="button" onclick="deleteCustomNotice('${n.id}')" style="background: transparent; border: none; font-size: 13px; color: #EF4444; cursor: pointer;" title="Eliminar aviso">
                            🗑️
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function addNewCustomNoticePrompt() {
            const title = prompt("Título del aviso (ej: Feriado, Evento Especial):", "Aviso Especial");
            if (!title) return;
            const message = prompt("Mensaje del aviso para clientes:", "Hoy cerramos 1 hora antes por evento privado.");
            if (!message) return;
            if (!businessConfig.customNotices) businessConfig.customNotices = [];
            businessConfig.customNotices.push({
                id: "notice_" + Date.now(),
                title: title.trim(),
                message: message.trim(),
                active: true
            });
            saveBusinessConfigToStorageAndCloud();
            renderManagerCustomNotices();
            showLiveToast("📢 Aviso Añadido", "El aviso especial se ha guardado correctamente.", "success", 3000);
        }

        function toggleCustomNoticeActive(noticeId) {
            const notice = (businessConfig.customNotices || []).find(n => n.id === noticeId);
            if (!notice) return;
            notice.active = !notice.active;
            saveBusinessConfigToStorageAndCloud();
            renderManagerCustomNotices();
        }

        function deleteCustomNotice(noticeId) {
            if (!confirm("¿Deseas eliminar este aviso especial?")) return;
            businessConfig.customNotices = (businessConfig.customNotices || []).filter(n => n.id !== noticeId);
            saveBusinessConfigToStorageAndCloud();
            renderManagerCustomNotices();
            showLiveToast("🗑️ Aviso Eliminado", "El aviso especial ha sido eliminado.", "info", 2000);
        }

        // --- SIMULADOR DE FUNCIONAMIENTO REAL ---
        function runScheduleSimulation() {
            const daySelect = document.getElementById('mgrSimDaySelect');
            const timeInput = document.getElementById('mgrSimTimeInput');
            const resultBox = document.getElementById('mgrSimulationResultBox');
            if (!resultBox) return;

            let simDay = daySelect ? daySelect.value : 'today';
            let targetDayNum = simDay === 'today' ? new Date().getDay() : parseInt(simDay);
            let targetTimeStr = timeInput ? timeInput.value : '12:00';

            const simResult = getBusinessScheduleInfo(targetDayNum, targetTimeStr);
            const dayNames = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];

            if (simResult.isOpen) {
                resultBox.style.background = '#DCFCE7';
                resultBox.style.borderColor = '#86EFAC';
                resultBox.style.color = '#15803D';
                resultBox.innerHTML = `
                    <span>🟢 <b>Resultado: ABIERTO</b></span><br>
                    <span style="font-size: 11px; font-weight: normal; color: #166534;">
                        Día: <b>${dayNames[targetDayNum]}</b> a las <b>${targetTimeStr}</b> (${simResult.badgeText})<br>
                        ${simResult.activeSlotName ? `Turno activo: <i>${simResult.activeSlotName}</i>` : 'Operación permitida'}
                    </span>
                `;
            } else {
                resultBox.style.background = '#FEE2E2';
                resultBox.style.borderColor = '#FCA5A5';
                resultBox.style.color = '#B91C1C';
                resultBox.innerHTML = `
                    <span>🔴 <b>Resultado: CERRADO</b></span><br>
                    <span style="font-size: 11px; font-weight: normal; color: #991B1B;">
                        Día: <b>${dayNames[targetDayNum]}</b> a las <b>${targetTimeStr}</b> (${simResult.badgeText})<br>
                        Motivo: ${simResult.alertMessage || 'Fuera del horario de atención de los turnos activos.'}
                    </span>
                `;
            }
        }

        function updateManagerModalInputs() {
            setManagerStatusOption(businessConfig.manualStatus || 'auto');
            const chk24 = document.getElementById('mgrCheckbox24h');
            const closedMsg = document.getElementById('mgrInputClosedMessage');
            const phoneInput = document.getElementById('mgrInputWhatsappPhone');
            const chkWa = document.getElementById('mgrCheckEnableWhatsapp');
            const chkTables = document.getElementById('mgrCheckEnableTables');
            const chkConsolidate = document.getElementById('mgrCheckConsolidation');

            if (chk24) chk24.checked = !!businessConfig.isOpen24h;
            if (closedMsg) closedMsg.value = businessConfig.closedMessage || "Nuestro horario de atención es de 8:00 AM a 10:30 PM. En este momento el restaurante está cerrado. ¡Te esperamos pronto!";
            if (phoneInput) phoneInput.value = businessConfig.whatsappPhone || "50255551234";
            if (chkWa) chkWa.checked = businessConfig.enableWhatsappOrders !== false;
            if (chkTables) chkTables.checked = businessConfig.enableTableOrders !== false;
            if (chkConsolidate) chkConsolidate.checked = businessConfig.allowComandaConsolidation !== false;

            renderManagerScheduleSlots();
            renderManagerCustomNotices();
            updateManagerLiveCalculation();
            updateManagerQrLinkPreview();
            updateClosedTabPreview();
            runScheduleSimulation();
        }

        function saveManagerConfig() {
            const closedMsg = document.getElementById('mgrInputClosedMessage');
            const phoneInput = document.getElementById('mgrInputWhatsappPhone');
            const chkWa = document.getElementById('mgrCheckEnableWhatsapp');
            const chkTables = document.getElementById('mgrCheckEnableTables');
            const chkConsolidate = document.getElementById('mgrCheckConsolidation');
            const chk24 = document.getElementById('mgrCheckbox24h');

            if (closedMsg) businessConfig.closedMessage = closedMsg.value.trim();
            if (phoneInput) businessConfig.whatsappPhone = phoneInput.value.replace(/[^0-9]/g, '') || "50255551234";
            if (chkWa) businessConfig.enableWhatsappOrders = chkWa.checked;
            if (chkTables) businessConfig.enableTableOrders = chkTables.checked;
            if (chkConsolidate) businessConfig.allowComandaConsolidation = chkConsolidate.checked;
            if (chk24) businessConfig.isOpen24h = chk24.checked;

            saveBusinessConfigToStorageAndCloud();
            updateScheduleStatus();
            updateManagerLiveCalculation();
            closeManagerModal();

            showLiveToast(
                "✅ Configuración Guardada",
                "Los cambios en horarios, jornadas y estado se han aplicado en tiempo real.",
                "success",
                4000
            );
        }

        function testWhatsappChatFromManager() {
            const phoneInput = document.getElementById('mgrInputWhatsappPhone');
            const phone = (phoneInput?.value || "50255551234").replace(/[^0-9]/g, '');
            const msg = encodeURIComponent("¡Hola! Prueba de enlace y recepción desde el Módulo de Gerente de Restaurante Rivera.");
            window.open(`https://wa.me/${phone}?text=${msg}`, '_blank');
        }

        function updateManagerQrLinkPreview() {
            const sel = document.getElementById('mgrSelectTableGenerator');
            const urlInput = document.getElementById('mgrInputQrGeneratedUrl');
            if (!sel || !urlInput) return;
            const tableVal = sel.value;
            const baseUrl = window.location.origin + window.location.pathname;
            const tableParam = encodeURIComponent(tableVal);
            urlInput.value = `${baseUrl}?mesa=${tableParam}`;
        }

        function copyManagerQrLink() {
            const urlInput = document.getElementById('mgrInputQrGeneratedUrl');
            if (!urlInput) return;
            navigator.clipboard.writeText(urlInput.value).then(() => {
                showLiveToast("📋 Enlace QR Copiado", `Enlace para ${document.getElementById('mgrSelectTableGenerator')?.value}: ${urlInput.value}`, "success", 4000);
            }).catch(() => {
                urlInput.select();
                document.execCommand('copy');
                showLiveToast("📋 Enlace Copiado", urlInput.value, "success", 4000);
            });
        }

        function testManagerQrLink() {
            const sel = document.getElementById('mgrSelectTableGenerator');
            if (!sel) return;
            applyTableChange(sel.value, true);
            closeManagerModal();
            showLiveToast("🍽️ Mesa Asignada", `Se aplicó ${sel.value} en la pantalla actual.`, "success", 4000);
        }

        // --- PLATILLOS & INVENTORY CONTROLLER IN MANAGER MODULE ---
        function renderManagerDishesList() {
            const container = document.getElementById('mgrDishesListContainer');
            const badgesContainer = document.getElementById('mgrDishesSummaryBadges');
            const searchVal = (document.getElementById('mgrSearchDishesInput')?.value || "").toLowerCase().trim();
            const statusFilter = document.getElementById('mgrFilterDishesStatus')?.value || "all";

            if (!container) return;

            const totalCount = menuProducts.length;
            const availableCount = menuProducts.filter(p => p.isAvailable).length;
            const agotadoCount = totalCount - availableCount;

            if (badgesContainer) {
                badgesContainer.innerHTML = `
                    <span class="schedule-badge open" style="font-size: 11px;">🟢 ${availableCount} disp.</span>
                    <span class="schedule-badge closed" style="font-size: 11px;">🔴 ${agotadoCount} agot.</span>
                `;
            }

            let filtered = menuProducts.filter(p => {
                const matchesSearch = !searchVal || p.name.toLowerCase().includes(searchVal) || (p.category && p.category.toLowerCase().includes(searchVal));
                const matchesStatus = statusFilter === 'all' 
                    ? true 
                    : (statusFilter === 'available' ? p.isAvailable : !p.isAvailable);
                return matchesSearch && matchesStatus;
            });

            if (filtered.length === 0) {
                container.innerHTML = `<div style="text-align: center; padding: 20px; color: #94A3B8; font-size: 12px;">No se encontraron platillos con esos filtros.</div>`;
                return;
            }

            container.innerHTML = filtered.map(p => {
                const isAvail = !!p.isAvailable;
                return `
                    <div class="mgr-dish-item ${isAvail ? '' : 'is-agotado'}">
                        <div style="display: flex; align-items: center; gap: 10px; min-width: 0;">
                            <span style="font-size: 20px; flex-shrink: 0;">${p.category === 'Bebidas' ? '🍺' : (p.category === 'Postres' ? '🍰' : '🍽️')}</span>
                            <div style="min-width: 0;">
                                <div style="font-size: 12.5px; font-weight: 700; color: #1E293B; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    ${p.name}
                                </div>
                                <div style="font-size: 11px; color: #64748B;">
                                    ${p.category || 'General'} • <strong>Q${Number(p.price).toFixed(2)}</strong>
                                </div>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                            <span style="font-size: 10.5px; font-weight: 800; color: ${isAvail ? '#166534' : '#991B1B'}; background: ${isAvail ? '#DCFCE7' : '#FEE2E2'}; padding: 3px 6px; border-radius: 6px;">
                                ${isAvail ? 'DISPONIBLE' : 'AGOTADO'}
                            </span>
                            <button type="button" class="btn-toggle-dish ${isAvail ? 'available' : 'agotado'}" onclick="toggleDishAvailabilityFromManager(${p.id})">
                                <span>${isAvail ? '🔴 Agotar' : '🟢 Habilitar'}</span>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleDishAvailabilityFromManager(productId) {
            const product = menuProducts.find(p => p.id === productId);
            if (!product) return;

            product.isAvailable = !product.isAvailable;
            saveMenuProductsToCache(menuProducts);

            // Sync with Firestore if active
            if (db) {
                db.collection("productos_menu").doc(String(productId)).set({
                    isAvailable: product.isAvailable,
                    updatedAt: new Date().toISOString()
                }, { merge: true }).catch(err => console.warn("Sync product error:", err));
            }

            // If product became out of stock, check if customer had it in cart
            if (!product.isAvailable) {
                const inCartIdx = cart.findIndex(c => c.product.id === productId);
                if (inCartIdx !== -1) {
                    cart.splice(inCartIdx, 1);
                    updateCartUI();
                    renderCartModalItems();
                    showLiveToast("⚠️ Platillo Agotado", `El platillo "${product.name}" ha sido marcado como agotado en cocina y retirado del carrito.`, "warning", 5000);
                }
            }

            renderProducts();
            renderCategories();
            renderManagerDishesList();

            showLiveToast(
                product.isAvailable ? "🟢 Platillo Disponible" : "🔴 Platillo Agotado",
                `"${product.name}" ahora figura como ${product.isAvailable ? 'DISPONIBLE' : 'AGOTADO'} en el catálogo web.`,
                product.isAvailable ? "success" : "warning",
                3000
            );
        }

        // --- ORDERS MONITOR IN MANAGER MODULE ---
        function renderManagerOrdersList() {
            const container = document.getElementById('mgrOrdersListContainer');
            if (!container) return;

            const localOrders = getStoredOrderHistory();
            if (localOrders.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 26px 16px; background: #F8FAFC; border-radius: 12px; border: 1.5px dashed #CBD5E1;">
                        <span style="font-size: 28px; display: block; margin-bottom: 6px;">📋</span>
                        <strong style="font-size: 13px; color: #475569; display: block;">No hay pedidos recientes registrados</strong>
                        <p style="font-size: 11.5px; color: #94A3B8; margin: 4px 0 0;">Los pedidos que envíen los clientes aparecerán listados aquí en tiempo real.</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = localOrders.map(ord => {
                const isWa = ord.orderFlow === 'whatsapp' || (ord.origin && (ord.origin.includes('Domicilio') || ord.origin.includes('Llevar')));
                const orderId = ord.webOrderId || `#${ord.id}`;
                const timeStr = ord.createdAt ? new Date(ord.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
                const itemsCount = ord.items ? ord.items.length : (ord.itemsJson ? JSON.parse(ord.itemsJson).length : 0);

                return `
                    <div class="mgr-order-card">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                            <div>
                                <span style="font-size: 13px; font-weight: 800; color: #1E293B;">${orderId}</span>
                                <span style="font-size: 11px; font-weight: 700; margin-left: 6px; padding: 2px 6px; border-radius: 6px; ${isWa ? 'background: #DCFCE7; color: #15803D;' : 'background: #EFF6FF; color: #1D4ED8;'}">
                                    ${isWa ? '🛵 WhatsApp Delivery' : `🍽️ ${ord.origin || 'Mesa'}`}
                                </span>
                            </div>
                            <span style="font-size: 11px; color: #64748B;">${timeStr}</span>
                        </div>
                        <div style="font-size: 12px; color: #334155; margin-bottom: 4px;">
                            <strong>Cliente:</strong> ${ord.customerName || 'Anónimo'} ${ord.customerPhone ? `(${ord.customerPhone})` : ''}
                        </div>
                        ${ord.deliveryAddress ? `
                            <div style="font-size: 11.5px; color: #475569; margin-bottom: 4px; background: #FFFFFF; padding: 6px 8px; border-radius: 6px; border: 1px solid #E2E8F0;">
                                📍 <strong>Dirección/GPS:</strong> ${ord.deliveryAddress}
                            </div>
                        ` : ''}
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px; font-size: 12px;">
                            <span style="color: #64748B;">${itemsCount} platillo(s) • ${ord.paymentMethod || 'Efectivo'}</span>
                            <strong style="font-size: 14px; color: var(--primary-color);">Total: Q${Number(ord.totalAmount || 0).toFixed(2)}</strong>
                        </div>
                    </div>
                `;
            }).join('');
        }

        async function saveManagerConfig() {
            const openInput = document.getElementById('mgrInputOpenTime');
            const closeInput = document.getElementById('mgrInputCloseTime');
            const chk24 = document.getElementById('mgrCheckbox24h');
            const closedMsg = document.getElementById('mgrInputClosedMessage');
            const phoneInput = document.getElementById('mgrInputWhatsappPhone');
            const chkWa = document.getElementById('mgrCheckEnableWhatsapp');
            const chkTables = document.getElementById('mgrCheckEnableTables');
            const chkConsolidate = document.getElementById('mgrCheckConsolidation');

            businessConfig.openTime = openInput ? openInput.value : "08:00";
            businessConfig.closeTime = closeInput ? closeInput.value : "22:30";
            businessConfig.isOpen24h = chk24 ? chk24.checked : false;
            businessConfig.closedMessage = closedMsg ? closedMsg.value.trim() : "";
            businessConfig.whatsappPhone = phoneInput ? phoneInput.value.replace(/[^0-9]/g, '') : "50255551234";
            businessConfig.enableWhatsappOrders = chkWa ? chkWa.checked : true;
            businessConfig.enableTableOrders = chkTables ? chkTables.checked : true;
            businessConfig.allowComandaConsolidation = chkConsolidate ? chkConsolidate.checked : true;

            localStorage.setItem('restaurante_business_config', JSON.stringify(businessConfig));

            if (db) {
                withTimeout(
                    db.collection("configuracion_web").doc("horario_atencion").set({
                        ...businessConfig,
                        updatedAt: new Date().toISOString()
                    }, { merge: true }),
                    3000
                ).catch(err => console.log("Guardado offline en Firestore:", err));
            }

            updateScheduleStatus();
            closeManagerModal();

            const statusText = businessConfig.manualStatus === 'closed' 
                ? '🔴 Restaurante Cerrado' 
                : (businessConfig.manualStatus === 'open' ? '🟢 Restaurante Abierto' : '🕒 Horario Automático');

            showLiveToast(
                "⚙️ Configuración de Gerencia Guardada",
                `Estado: ${statusText} • Horario: ${businessConfig.openTime} a ${businessConfig.closeTime}. Los cambios ya están activos en la web.`,
                "success",
                5000
            );
        }
        // --- ORDER FLOWS LOGIC: PEDIDOS POR MESA vs PEDIDOS POR WHATSAPP ---
        function switchOrderFlow(flow) {
            currentOrderFlow = flow;
            const btnTable = document.getElementById('btnFlowTable');
            const btnWhatsapp = document.getElementById('btnFlowWhatsapp');
            const containerTable = document.getElementById('flowContainerTable');
            const containerWhatsapp = document.getElementById('flowContainerWhatsapp');

            if (flow === 'mesa') {
                if (btnTable) btnTable.classList.add('active');
                if (btnWhatsapp) btnWhatsapp.classList.remove('active');
                if (containerTable) containerTable.style.display = 'block';
                if (containerWhatsapp) containerWhatsapp.style.display = 'none';
            } else {
                if (btnWhatsapp) btnWhatsapp.classList.add('active');
                if (btnTable) btnTable.classList.remove('active');
                if (containerWhatsapp) containerWhatsapp.style.display = 'block';
                if (containerTable) containerTable.style.display = 'none';
            }

            updateScheduleStatus();
        }

        function getActiveSelectedTable() {
            const sel = document.getElementById('selectFlowTableNumber');
            if (sel && sel.value) return sel.value;
            const lbl = document.getElementById('tableLabel');
            if (lbl && lbl.textContent) return lbl.textContent;
            return 'Mesa 1';
        }

        function onFlowTableChange(tableStr) {
            if (!tableStr) return;
            const disp = document.getElementById('flowTableDisplayNum');
            if (disp) disp.textContent = tableStr;
            const lbl = document.getElementById('tableLabel');
            if (lbl) lbl.textContent = tableStr;
            localStorage.setItem('restaurante_selected_table', tableStr);
            updateScheduleStatus();
            checkAndDisplayTableStatusInCart(true);
        }

        function requestCurrentGpsLocation() {
            const btn = document.getElementById('btnGetGpsLocation');
            const mapInput = document.getElementById('inputWhatsappMapLink');
            const statusBox = document.getElementById('gpsLocationStatus');

            if (!navigator.geolocation) {
                showLiveToast("GPS No Disponible", "Tu dispositivo no soporta geolocalización.", "warning");
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span>⏳ Obteniendo GPS...</span>`;
            }

            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const lat = pos.coords.latitude.toFixed(6);
                    const lng = pos.coords.longitude.toFixed(6);
                    const accuracy = Math.round(pos.coords.accuracy);
                    const googleMapsUrl = `https://maps.google.com/?q=${lat},${lng}`;
                    const wazeUrl = `https://waze.com/ul?ll=${lat},${lng}&navigate=yes`;

                    lastAcquiredGpsData = { lat, lng, accuracy, googleMapsUrl, wazeUrl };

                    if (mapInput) {
                        mapInput.value = googleMapsUrl;
                        mapInput.classList.remove('is-invalid');
                        mapInput.classList.add('is-valid');
                    }

                    if (statusBox) {
                        statusBox.style.display = 'block';
                        statusBox.innerHTML = `
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 6px; flex-wrap: wrap; background: #F0FDF4; border: 1px solid #86EFAC; padding: 6px 10px; border-radius: 8px;">
                                <span style="font-size: 11px; font-weight: 700; color: #166534;">✅ Ubicación detectada (±${accuracy}m)</span>
                                <div style="display: flex; gap: 6px;">
                                    <a href="${googleMapsUrl}" target="_blank" class="map-chip-btn google" title="Abrir en Google Maps">🗺️ Google Maps</a>
                                    <a href="${wazeUrl}" target="_blank" class="map-chip-btn waze" title="Abrir en Waze">🚙 Waze</a>
                                </div>
                            </div>
                        `;
                    }

                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = `<span>📍 Actualizar GPS</span>`;
                    }

                    showLiveToast("Ubicación GPS Obtenida", "Coordenadas capturadas con éxito para la entrega.", "success", 3000);
                    validateWhatsappFields();
                },
                (err) => {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = `<span>📍 Obtener Mi Ubicación (GPS)</span>`;
                    }
                    let msg = "No se pudo obtener la ubicación GPS.";
                    if (err.code === 1) msg = "Permiso de GPS denegado. Escribe tu dirección en el campo Ubicación 2.";
                    showLiveToast("Aviso de Ubicación", msg, "warning", 4000);
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        }

        function validateWhatsappFields(showErrors = true) {
            const nameInput = document.getElementById('inputWhatsappName');
            const phoneInput = document.getElementById('inputWhatsappPhone');
            const addrInput = document.getElementById('inputWhatsappAddress');
            const nameFeedback = document.getElementById('whatsappNameFeedback');
            const phoneFeedback = document.getElementById('whatsappPhoneFeedback');
            const addrFeedback = document.getElementById('whatsappAddressFeedback');
            const nameIcon = document.getElementById('whatsappNameStatusIcon');
            const phoneIcon = document.getElementById('whatsappPhoneStatusIcon');

            let isValid = true;

            // Validate Name
            if (nameInput && nameFeedback) {
                const nameVal = nameInput.value.trim();
                if (nameVal.length < 2) {
                    if (showErrors) {
                        nameInput.classList.remove('is-valid');
                        nameInput.classList.add('is-invalid');
                        nameFeedback.className = 'field-feedback error';
                        nameFeedback.innerHTML = '⚠️ Ingresa el nombre de quien recibe el pedido.';
                        if (nameIcon) nameIcon.innerHTML = '❌';
                    }
                    isValid = false;
                } else {
                    nameInput.classList.remove('is-invalid');
                    nameInput.classList.add('is-valid');
                    nameFeedback.className = 'field-feedback success';
                    nameFeedback.innerHTML = '✓ Nombre verificado';
                    if (nameIcon) nameIcon.innerHTML = '✅';
                }
            }

            // Validate Phone
            if (phoneInput && phoneFeedback) {
                const phoneDigits = phoneInput.value.replace(/[^0-9]/g, '');
                if (phoneDigits.length < 8) {
                    if (showErrors) {
                        phoneInput.classList.remove('is-valid');
                        phoneInput.classList.add('is-invalid');
                        phoneFeedback.className = 'field-feedback error';
                        phoneFeedback.innerHTML = '⚠️ Ingresa un número de teléfono válido (mínimo 8 dígitos).';
                        if (phoneIcon) phoneIcon.innerHTML = '❌';
                    }
                    isValid = false;
                } else {
                    phoneInput.classList.remove('is-invalid');
                    phoneInput.classList.add('is-valid');
                    phoneFeedback.className = 'field-feedback success';
                    phoneFeedback.innerHTML = '✓ Teléfono listo para WhatsApp';
                    if (phoneIcon) phoneIcon.innerHTML = '✅';
                }
            }

            // Validate Address (Ubicación 2)
            if (addrInput && addrFeedback) {
                const addrVal = addrInput.value.trim();
                if (addrVal.length < 4) {
                    if (showErrors) {
                        addrInput.classList.remove('is-valid');
                        addrInput.classList.add('is-invalid');
                        addrFeedback.className = 'field-feedback error';
                        addrFeedback.innerHTML = '⚠️ Escribe la dirección exacta y referencias de entrega.';
                    }
                    isValid = false;
                } else {
                    addrInput.classList.remove('is-invalid');
                    addrInput.classList.add('is-valid');
                    addrFeedback.className = 'field-feedback success';
                    addrFeedback.innerHTML = '✓ Dirección de entrega confirmada';
                }
            }

            return isValid;
        }

        function initPredictiveSearch() {
            const searchInput = document.getElementById('searchInput');
            const btnClear = document.getElementById('btnClearSearch');
            const dropdown = document.getElementById('predictiveDropdown');
            const predictiveList = document.getElementById('predictiveList');
            const predictiveFooter = document.getElementById('predictiveFooter');

            if (!searchInput) return;

            function highlightMatch(text, query) {
                if (!query) return text;
                const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
                return text.replace(regex, '<mark>$1</mark>');
            }

            function updatePredictiveSuggestions() {
                const query = searchInput.value.trim().toLowerCase();
                selectedPredictiveIndex = -1;

                if (query.length === 0) {
                    dropdown.style.display = 'none';
                    return;
                }

                const matches = menuProducts.filter(item => {
                    if (!item.isVisibleWeb) return false;
                    const nameMatch = item.name.toLowerCase().includes(query);
                    const descMatch = item.description && item.description.toLowerCase().includes(query);
                    const catMatch = item.category && item.category.toLowerCase().includes(query);
                    return nameMatch || descMatch || catMatch;
                }).slice(0, 5); // Limit to top 5 matches

                if (matches.length === 0) {
                    predictiveList.innerHTML = `
                        <div style="padding: 12px; text-align: center; color: var(--text-muted); font-size: 12px;">
                            Sin sugerencias directas para "<strong>${searchInput.value}</strong>"
                        </div>
                    `;
                    predictiveFooter.textContent = `Buscar en catálogo por "${searchInput.value}"`;
                    dropdown.style.display = 'block';
                    return;
                }

                document.getElementById('predictiveCount').textContent = `${matches.length} sugerencia${matches.length > 1 ? 's' : ''}`;
                predictiveFooter.textContent = `Ver todos los resultados para "${searchInput.value}"`;

                predictiveList.innerHTML = matches.map((item, index) => {
                    const fallbackImg = getCategoryPlaceholder(item.category);
                    const displayImg = item.imageUrl && item.imageUrl.trim().length > 0 ? item.imageUrl : fallbackImg;
                    const highlightedName = highlightMatch(item.name, query);

                    return `
                        <div class="predictive-item" data-index="${index}" onclick="selectPredictiveItem(${item.id})">
                            <img src="${displayImg}" class="predictive-thumb" alt="${item.name}" onerror="this.src='${fallbackImg}'">
                            <div class="predictive-info">
                                <div class="predictive-name">${highlightedName}</div>
                                <div class="predictive-meta">
                                    <span class="product-cat-badge" style="font-size: 9px; padding: 1px 5px;">${item.category}</span>
                                    <span class="predictive-price">Q${Number(item.price).toFixed(2)}</span>
                                    ${!item.isAvailable ? `<span style="color: #DC2626; font-size: 10px; font-weight: bold;">(Agotado)</span>` : ''}
                                </div>
                            </div>
                            <button type="button" class="predictive-btn-add" ${!item.isAvailable ? 'disabled style="opacity: 0.5;"' : ''} onclick="event.stopPropagation(); addToCart(${item.id});">
                                ${item.isAvailable ? '+ Agregar' : 'Agotado'}
                            </button>
                        </div>
                    `;
                }).join('');

                dropdown.style.display = 'block';
            }

            // Keyboard navigation in predictive search
            searchInput.addEventListener('keydown', (e) => {
                const items = dropdown.querySelectorAll('.predictive-item');
                if (dropdown.style.display !== 'block' || items.length === 0) {
                    if (e.key === 'Enter') {
                        dropdown.style.display = 'none';
                        searchQuery = searchInput.value.trim();
                        renderProducts();
                    }
                    return;
                }

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    selectedPredictiveIndex = (selectedPredictiveIndex + 1) % items.length;
                    items.forEach((it, idx) => it.classList.toggle('selected', idx === selectedPredictiveIndex));
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    selectedPredictiveIndex = (selectedPredictiveIndex - 1 + items.length) % items.length;
                    items.forEach((it, idx) => it.classList.toggle('selected', idx === selectedPredictiveIndex));
                } else if (e.key === 'Enter') {
                    e.preventDefault();
                    if (selectedPredictiveIndex >= 0 && items[selectedPredictiveIndex]) {
                        items[selectedPredictiveIndex].click();
                    } else {
                        applyFullSearchFromPredictive();
                    }
                } else if (e.key === 'Escape') {
                    dropdown.style.display = 'none';
                }
            });

            // Input typing listener with predictive suggestions
            searchInput.addEventListener('input', (e) => {
                searchQuery = e.target.value;
                btnClear.style.display = searchQuery.length > 0 ? 'flex' : 'none';
                updatePredictiveSuggestions();
                renderProducts();
            });

            searchInput.addEventListener('focus', () => {
                if (searchInput.value.trim().length > 0) {
                    updatePredictiveSuggestions();
                }
            });

            // Click outside to close dropdown
            document.addEventListener('click', (e) => {
                const container = document.getElementById('searchBoxContainer');
                if (container && !container.contains(e.target)) {
                    dropdown.style.display = 'none';
                }
            });

            // Clear search button
            btnClear.addEventListener('click', () => {
                searchInput.value = '';
                searchQuery = '';
                btnClear.style.display = 'none';
                dropdown.style.display = 'none';
                renderProducts();
                searchInput.focus();
            });
        }

        function selectPredictiveItem(productId) {
            const item = menuProducts.find(p => p.id === productId);
            if (!item) return;

            const searchInput = document.getElementById('searchInput');
            const dropdown = document.getElementById('predictiveDropdown');
            const btnClear = document.getElementById('btnClearSearch');

            searchInput.value = item.name;
            searchQuery = item.name;
            btnClear.style.display = 'flex';
            dropdown.style.display = 'none';

            renderProducts();

            // Smoothly scroll to the matched product card and highlight it
            setTimeout(() => {
                const card = document.getElementById(`product-${productId}`);
                if (card) {
                    card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    card.style.transition = "box-shadow 0.3s ease, transform 0.3s ease";
                    card.style.boxShadow = "0 0 0 3px var(--primary-light), 0 8px 20px rgba(0,0,0,0.15)";
                    card.style.transform = "scale(1.02)";
                    setTimeout(() => {
                        card.style.boxShadow = "";
                        card.style.transform = "";
                    }, 1400);
                }
            }, 100);
        }

        function applyFullSearchFromPredictive() {
            const dropdown = document.getElementById('predictiveDropdown');
            const searchInput = document.getElementById('searchInput');
            if (dropdown) dropdown.style.display = 'none';
            if (searchInput) {
                searchQuery = searchInput.value.trim();
                renderProducts();
            }
        }

        function initVoiceSearch() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            const btnVoice = document.getElementById('btnVoiceSearch');
            const searchBox = document.getElementById('searchBoxContainer');
            const voiceBanner = document.getElementById('voiceSearchBanner');
            const voiceText = document.getElementById('voiceListeningText');
            const searchInput = document.getElementById('searchInput');
            const btnClear = document.getElementById('btnClearSearch');

            if (!SpeechRecognition) {
                btnVoice.addEventListener('click', () => {
                    showLiveToast(
                        "Búsqueda por Voz",
                        "Tu navegador no soporta Web Speech API directamente. Puedes escribir en el buscador.",
                        "info",
                        4000
                    );
                });
                return;
            }

            speechRecognitionInstance = new SpeechRecognition();
            speechRecognitionInstance.continuous = false;
            speechRecognitionInstance.interimResults = true;
            speechRecognitionInstance.lang = 'es-GT'; // Spanish Guatemala / Latin America

            speechRecognitionInstance.onstart = () => {
                isVoiceListening = true;
                btnVoice.classList.add('listening');
                searchBox.classList.add('is-listening');
                voiceBanner.style.display = 'flex';
                voiceText.textContent = "🎙️ Escuchando... Di el nombre de un platillo o bebida";
                if (navigator.vibrate) navigator.vibrate(40);
            };

            speechRecognitionInstance.onresult = (event) => {
                let transcript = "";
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    transcript += event.results[i][0].transcript;
                }

                const cleanTranscript = transcript.trim();
                if (cleanTranscript) {
                    searchInput.value = cleanTranscript;
                    searchQuery = cleanTranscript;
                    btnClear.style.display = 'flex';
                    voiceText.textContent = `🎙️ "${cleanTranscript}"`;
                    renderProducts();
                }
            };

            speechRecognitionInstance.onerror = (event) => {
                console.warn("Speech recognition error:", event.error);
                stopVoiceSearch();
                if (event.error === 'not-allowed') {
                    showLiveToast("Permiso de Micrófono", "Por favor permite el acceso al micrófono para buscar por voz.", "warning", 4500);
                } else if (event.error !== 'no-speech') {
                    showLiveToast("Búsqueda por Voz", "No se detectó audio. Por favor intenta de nuevo.", "info", 3000);
                }
            };

            speechRecognitionInstance.onend = () => {
                stopVoiceSearch();
                if (searchQuery.trim().length > 0) {
                    showLiveToast("Búsqueda por Voz", `Buscando resultados para: "<strong>${searchQuery}</strong>"`, "success", 2500);
                }
            };

            btnVoice.addEventListener('click', () => {
                if (isVoiceListening) {
                    stopVoiceSearch();
                } else {
                    startVoiceSearch();
                }
            });
        }

        function startVoiceSearch() {
            if (!speechRecognitionInstance) return;
            try {
                speechRecognitionInstance.start();
            } catch (err) {
                console.warn("Speech recognition start failed:", err);
            }
        }

        function stopVoiceSearch() {
            isVoiceListening = false;
            const btnVoice = document.getElementById('btnVoiceSearch');
            const searchBox = document.getElementById('searchBoxContainer');
            const voiceBanner = document.getElementById('voiceSearchBanner');

            if (btnVoice) btnVoice.classList.remove('listening');
            if (searchBox) searchBox.classList.remove('is-listening');
            if (voiceBanner) voiceBanner.style.display = 'none';

            if (speechRecognitionInstance) {
                try {
                    speechRecognitionInstance.stop();
                } catch (e) {}
            }
        }

        // --- 8. RICH ADD-TO-CART NOTIFICATIONS & CART ACTIONS ---
        function showAddToCartToast(product, quantityInCart) {
            const container = document.getElementById('liveToastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            toast.className = 'live-toast cart-success';

            const fallbackImg = getCategoryPlaceholder(product.category);
            const displayImg = product.imageUrl && product.imageUrl.trim().length > 0 ? product.imageUrl : fallbackImg;

            toast.innerHTML = `
                <img src="${displayImg}" class="toast-thumb-img" alt="${product.name}" onerror="this.src='${fallbackImg}'">
                <div class="toast-cart-details">
                    <div style="font-size: 10.5px; font-weight: 800; color: #34D399; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px;">
                        ✓ Agregado al Carrito
                    </div>
                    <div class="toast-cart-title">${product.name}</div>
                    <div class="toast-cart-meta">
                        <span>Q${Number(product.price).toFixed(2)}</span>
                        <span class="toast-cart-qty">x${quantityInCart} en orden</span>
                    </div>
                </div>
                <button type="button" class="btn-toast-cart" onclick="openCartModal()">
                    <span>Ver Carrito 🛒</span>
                </button>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.animation = "toastFadeOut 0.3s forwards";
                setTimeout(() => {
                    if (toast.parentNode) {
                        toast.parentNode.removeChild(toast);
                    }
                }, 300);
            }, 3600);
        }

        function addToCart(productId) {
            const product = menuProducts.find(p => p.id === productId);
            if (!product) return;

            if (!product.isAvailable) {
                showLiveToast(
                    "⚠️ Platillo Agotado",
                    `Lo sentimos, <strong>${product.name}</strong> está marcado como agotado en cocina.`,
                    "warning",
                    3500
                );
                return;
            }

            const existing = cart.find(c => c.product.id === productId);
            let currentQty = 1;
            if (existing) {
                existing.quantity += 1;
                currentQty = existing.quantity;
            } else {
                cart.push({
                    product: product,
                    quantity: 1,
                    notes: ""
                });
            }

            // Interactive Button visual feedback
            const btn = document.getElementById(`btnAdd-${productId}`);
            if (btn) {
                btn.classList.add('just-added');
                const origText = btn.innerHTML;
                btn.innerHTML = `✓ ¡Agregado!`;
                setTimeout(() => {
                    btn.classList.remove('just-added');
                    btn.innerHTML = origText;
                }, 900);
            }

            // Bounce the floating bottom cart bar
            const cartBar = document.getElementById('cartBar');
            if (cartBar) {
                cartBar.classList.remove('bounce');
                void cartBar.offsetWidth; // Trigger reflow
                cartBar.classList.add('bounce');
            }

            // Haptic feedback
            if (navigator.vibrate) navigator.vibrate([30, 20, 30]);

            // Show rich toast notification
            showAddToCartToast(product, currentQty);

            updateCartUI();
            showCartBar();
        }

        function updateCartQuantity(productId, delta) {
            const index = cart.findIndex(c => c.product.id === productId);
            if (index !== -1) {
                cart[index].quantity += delta;
                if (cart[index].quantity <= 0) {
                    cart.splice(index, 1);
                }
            }
            updateCartUI();
            renderCartModalItems();
        }

        function updateCartUI() {
            const totalCount = cart.reduce((acc, item) => acc + item.quantity, 0);
            const subtotal = cart.reduce((acc, item) => acc + (item.product.price * item.quantity), 0);

            document.getElementById('cartCountBadge').textContent = totalCount;
            const tabCartBadge = document.getElementById('tabCartCountBadge');
            const bnavCartBadge = document.getElementById('bnavCartBadge');
            if (tabCartBadge) {
                tabCartBadge.textContent = totalCount;
                tabCartBadge.style.display = totalCount > 0 ? 'inline-flex' : 'none';
            }
            if (bnavCartBadge) {
                bnavCartBadge.textContent = totalCount;
                bnavCartBadge.style.display = totalCount > 0 ? 'flex' : 'none';
            }
            document.getElementById('tabCountCurrent').textContent = totalCount;
            document.getElementById('cartBarItemsSummary').textContent = `${totalCount} ${totalCount === 1 ? 'producto' : 'productos'} seleccionados`;
            document.getElementById('cartBarTotal').textContent = `Q${subtotal.toFixed(2)}`;

            updateOrderHistoryBadge();
            updateScheduleStatus();
            renderEstimatedWaitTimeUI();

            if (totalCount > 0) {
                showCartBar();
            } else {
                hideCartBar();
            }
        }

        function showCartBar() {
            document.getElementById('cartBar').classList.add('visible');
        }

        function hideCartBar() {
            document.getElementById('cartBar').classList.remove('visible');
        }

        // --- 9. MODAL TAB NAVIGATION (CURRENT ORDER vs. ORDER HISTORY) ---
        let currentModalTab = 'current';

        function switchModalTab(tab) {
            currentModalTab = tab;
            const btnCurrent = document.getElementById('tabBtnCurrent');
            const btnHistory = document.getElementById('tabBtnHistory');
            const viewCurrent = document.getElementById('viewCurrentOrder');
            const viewHistory = document.getElementById('viewOrderHistory');
            const modalFooter = document.getElementById('modalFooter');

            if (tab === 'current') {
                btnCurrent.classList.add('active');
                btnHistory.classList.remove('active');
                viewCurrent.style.display = 'block';
                viewHistory.style.display = 'none';

                renderCartModalItems();
                updateScheduleStatus();
            } else {
                btnHistory.classList.add('active');
                btnCurrent.classList.remove('active');
                viewCurrent.style.display = 'none';
                viewHistory.style.display = 'block';

                renderOrderHistory();

                // Footer in history tab
                modalFooter.innerHTML = `
                    <button class="btn-confirm-order" style="background: var(--surface-color); color: var(--primary-color); border: 1.5px solid var(--border-color); box-shadow: none;" onclick="closeCartModal()">
                        <span>← Regresar al Menú</span>
                    </button>
                `;
            }
        }

        function openCartModal(defaultTab = 'current') {
            loadSavedCustomerInfo();
            switchModalTab(defaultTab);
            document.getElementById('modalBackdrop').classList.add('open');
            document.getElementById('cartModal').classList.add('open');
            if (defaultTab === 'current') {
                checkAndDisplayTableStatusInCart(false);
            }
        }

        function closeCartModal() {
            document.getElementById('modalBackdrop').classList.remove('open');
            document.getElementById('cartModal').classList.remove('open');
        }

        // Complementary Products Recommender Engine (Bebidas, Postres, Entradas)
        function getComplementarySuggestions() {
            if (cart.length === 0) return [];

            const cartProductIds = new Set(cart.map(c => c.product.id));
            const hasPlatillo = cart.some(c => (c.product.category || "").toLowerCase().includes("platillo"));
            const hasBebida = cart.some(c => (c.product.category || "").toLowerCase().includes("bebida"));
            const hasPostre = cart.some(c => (c.product.category || "").toLowerCase().includes("postre"));

            // Select available products not in cart
            const availableProducts = menuProducts.filter(p => p.isAvailable && p.isVisibleWeb && !cartProductIds.has(p.id));

            let suggestions = [];

            if (hasPlatillo && !hasBebida) {
                const drinks = availableProducts.filter(p => (p.category || "").toLowerCase().includes("bebida"));
                suggestions.push(...drinks.slice(0, 2));
            }
            if (hasPlatillo && !hasPostre) {
                const desserts = availableProducts.filter(p => (p.category || "").toLowerCase().includes("postre"));
                suggestions.push(...desserts.slice(0, 2));
            }

            // Fallback suggestions: drinks or desserts if empty
            if (suggestions.length === 0) {
                const generalComplements = availableProducts.filter(p => {
                    const c = (p.category || "").toLowerCase();
                    return c.includes("bebida") || c.includes("postre") || c.includes("entrada");
                });
                suggestions.push(...generalComplements.slice(0, 3));
            }

            return suggestions.slice(0, 3);
        }

        function renderCrossSellSection() {
            const container = document.getElementById('crossSellContainer');
            if (!container) return;

            if (cart.length === 0) {
                container.style.display = 'none';
                container.innerHTML = '';
                return;
            }

            const suggestions = getComplementarySuggestions();
            if (suggestions.length === 0) {
                container.style.display = 'none';
                container.innerHTML = '';
                return;
            }

            container.style.display = 'block';
            container.innerHTML = `
                <div class="cross-sell-section">
                    <div class="cross-sell-header">
                        <div class="cross-sell-title">
                            <span>✨ Completa tu Experiencia</span>
                        </div>
                        <span class="cross-sell-tag">Sugerencias</span>
                    </div>
                    <div class="cross-sell-grid">
                        ${suggestions.map(s => {
                            const fallbackImg = getCategoryPlaceholder(s.category);
                            const displayImg = s.imageUrl && s.imageUrl.trim().length > 0 ? s.imageUrl : fallbackImg;
                            return `
                                <div class="cross-sell-card">
                                    <div>
                                        <div class="cross-sell-img-row">
                                            <img src="${displayImg}" class="cross-sell-thumb" alt="${s.name}" onerror="this.src='${fallbackImg}'">
                                            <div class="cross-sell-info">
                                                <h5>${s.name}</h5>
                                                <p>${s.category}</p>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="cross-sell-footer">
                                        <span class="cross-sell-price">Q${Number(s.price).toFixed(2)}</span>
                                        <button type="button" class="btn-add-cross-sell" onclick="addToCart(${s.id})">
                                            + Agregar
                                        </button>
                                    </div>
                                </div>
                            `;
                        }).join('')}
                    </div>
                </div>
            `;
        }

        // Render Cart Items with smooth Slide-Up Animation
        function renderCartModalItems() {
            const listContainer = document.getElementById('cartItemsList');
            const subtotal = cart.reduce((acc, item) => acc + (item.product.price * item.quantity), 0);
            const tip = subtotal * 0.10; // 10% tip
            const grandTotal = subtotal + tip;

            if (cart.length === 0) {
                listContainer.innerHTML = `
                    <div style="text-align: center; padding: 24px 10px; color: var(--text-muted);">
                        <div style="font-size: 32px; margin-bottom: 6px;">🛒</div>
                        <p style="font-weight: 700; color: var(--text-main);">Tu carrito está vacío</p>
                        <p style="font-size: 12px; margin-top: 2px;">Agrega platillos o revisa tu historial de órdenes.</p>
                    </div>
                `;
                document.getElementById('summarySubtotal').textContent = `Q0.00`;
                document.getElementById('summaryTip').textContent = `Q0.00`;
                document.getElementById('summaryTotal').textContent = `Q0.00`;

                renderCrossSellSection();

                document.getElementById('modalFooter').innerHTML = `
                    <button class="btn-confirm-order" style="background: #94A3B8; cursor: not-allowed;" disabled>
                        <span>Carrito Vacío</span>
                    </button>
                `;
                return;
            }

            listContainer.innerHTML = cart.map((item, index) => {
                const itemNotes = item.notes || "";
                const quickChips = [
                    { label: "🧅 Sin cebolla", val: "Sin cebolla" },
                    { label: "🥣 Salsa aparte", val: "Salsa aparte" },
                    { label: "🌶️ Sin picante", val: "Sin picante" },
                    { label: "🥩 Término medio", val: "Término medio" },
                    { label: "🔥 Bien cocido", val: "Bien cocido" },
                    { label: "🧊 Poco hielo", val: "Poco hielo" },
                    { label: "🧂 Sin sal", val: "Sin sal" }
                ];

                return `
                <div class="cart-item-card" id="itemCard_${index}" style="--item-idx: ${index};">
                    <div class="cart-item-main-row">
                        <div class="cart-item-info">
                            <h4>${item.product.name}</h4>
                            <p>Q${Number(item.product.price).toFixed(2)} c/u</p>
                        </div>
                        <div class="cart-qty-control">
                            <button class="btn-qty" onclick="updateCartQuantity(${item.product.id}, -1)">−</button>
                            <span class="qty-val">${item.quantity}</span>
                            <button class="btn-qty" onclick="updateCartQuantity(${item.product.id}, 1)">+</button>
                        </div>
                    </div>

                    <!-- Item-Specific Special Instructions -->
                    <div class="cart-item-notes-section">
                        <div class="cart-item-notes-input-wrapper">
                            <span class="note-icon">✍️</span>
                            <input type="text" 
                                   class="cart-item-notes-input" 
                                   id="itemNoteInput_${index}"
                                   value="${escapeHtml(itemNotes)}" 
                                   placeholder="Instrucciones para cocina (ej. sin cebolla, salsa aparte...)"
                                   oninput="updateCartItemNotes(${index}, this.value)">
                            <button type="button" 
                                    class="btn-clear-item-note" 
                                    style="${itemNotes ? 'display: inline-block;' : 'display: none;'}"
                                    onclick="clearCartItemNotes(${index})" 
                                    title="Borrar notas">✕</button>
                        </div>
                        <div class="cart-item-chips-scroll">
                            ${quickChips.map(qc => {
                                const isActive = itemNotes.includes(qc.val);
                                return `
                                    <button type="button" 
                                            class="item-quick-chip ${isActive ? 'active' : ''}" 
                                            data-chip-text="${qc.val}"
                                            onclick="toggleQuickChipToItem(${index}, '${qc.val}')">
                                        ${qc.label}
                                    </button>
                                `;
                            }).join('')}
                        </div>
                    </div>
                </div>
                `;
            }).join('');

            renderCrossSellSection();

            document.getElementById('summarySubtotal').textContent = `Q${subtotal.toFixed(2)}`;
            document.getElementById('summaryTip').textContent = `Q${tip.toFixed(2)}`;
            document.getElementById('summaryTotal').textContent = `Q${grandTotal.toFixed(2)}`;

            document.getElementById('modalFooter').innerHTML = `
                <button class="btn-confirm-order" id="btnConfirmOrder" onclick="submitWebOrder()">
                    <span>Confirmar y Enviar Pedido</span> ➔
                </button>
            `;

            updateScheduleStatus();
            checkAndDisplayTableStatusInCart(false);
        }

        // --- Item Notes Helpers ---
        function updateCartItemNotes(index, noteVal) {
            if (cart[index]) {
                cart[index].notes = noteVal;
                const card = document.getElementById(`itemCard_${index}`);
                if (card) {
                    const clearBtn = card.querySelector('.btn-clear-item-note');
                    if (clearBtn) {
                        clearBtn.style.display = noteVal.trim().length > 0 ? 'inline-block' : 'none';
                    }
                    const chips = card.querySelectorAll('.item-quick-chip');
                    chips.forEach(chip => {
                        const chipVal = chip.getAttribute('data-chip-text');
                        if (chipVal && noteVal.includes(chipVal)) {
                            chip.classList.add('active');
                        } else {
                            chip.classList.remove('active');
                        }
                    });
                }
            }
        }

        function clearCartItemNotes(index) {
            if (cart[index]) {
                cart[index].notes = "";
                const inp = document.getElementById(`itemNoteInput_${index}`);
                if (inp) inp.value = "";
                updateCartItemNotes(index, "");
            }
        }

        function toggleQuickChipToItem(index, chipText) {
            if (!cart[index]) return;
            let current = (cart[index].notes || "").trim();
            if (current.includes(chipText)) {
                current = current.replace(chipText, "")
                                 .replace(/,\s*,/g, ",")
                                 .replace(/^,\s*|,\s*$/g, "")
                                 .trim();
            } else {
                if (current.length > 0) {
                    current = `${current}, ${chipText}`;
                } else {
                    current = chipText;
                }
            }
            cart[index].notes = current;
            const inp = document.getElementById(`itemNoteInput_${index}`);
            if (inp) inp.value = current;
            updateCartItemNotes(index, current);
        }

        // --- 10. ORDER HISTORY & OFFLINE PERSISTENCE QUEUE (LOCAL STORAGE) ---
        const ORDER_HISTORY_STORAGE_KEY = "restaurante_customer_orders";
        const OFFLINE_ORDERS_QUEUE_KEY = "restaurante_offline_orders_queue";
        let isSyncingOfflineOrders = false;

        function getOfflineOrdersQueue() {
            try {
                const stored = localStorage.getItem(OFFLINE_ORDERS_QUEUE_KEY);
                return stored ? JSON.parse(stored) : [];
            } catch (e) {
                console.error("Error leyendo cola de pedidos offline:", e);
                return [];
            }
        }

        function saveOfflineOrdersQueue(queue) {
            try {
                localStorage.setItem(OFFLINE_ORDERS_QUEUE_KEY, JSON.stringify(queue));
                updateOfflineQueueUI();
            } catch (e) {
                console.error("Error guardando cola de pedidos offline:", e);
            }
        }

        function addOrderToOfflineQueue(orderDoc, isConsolidation = false, activeOrderInfo = null) {
            const queue = getOfflineOrdersQueue();
            const queueItem = {
                id: orderDoc.id || Date.now(),
                webOrderId: orderDoc.webOrderId,
                orderDocument: orderDoc,
                isConsolidation: !!isConsolidation,
                activeOrderInfo: activeOrderInfo ? {
                    orderId: activeOrderInfo.orderId,
                    docId: activeOrderInfo.docId,
                    source: activeOrderInfo.source
                } : null,
                queuedAt: Date.now(),
                retryCount: 0,
                status: "offline_queued"
            };

            const existingIdx = queue.findIndex(q => q.webOrderId === orderDoc.webOrderId);
            if (existingIdx >= 0) {
                queue[existingIdx] = queueItem;
            } else {
                queue.push(queueItem);
            }
            saveOfflineOrdersQueue(queue);

            // Also keep in pedidos_web_cache for local lookup
            try {
                const cached = JSON.parse(localStorage.getItem("pedidos_web_cache") || "[]");
                if (!cached.some(c => c.webOrderId === orderDoc.webOrderId)) {
                    cached.push(orderDoc);
                    localStorage.setItem("pedidos_web_cache", JSON.stringify(cached));
                }
            } catch (e) {}

            return queueItem;
        }

        function removeOrderFromOfflineQueue(webOrderId) {
            let queue = getOfflineOrdersQueue();
            queue = queue.filter(q => q.webOrderId !== webOrderId);
            saveOfflineOrdersQueue(queue);
        }

        function updateHistoryOrderStatus(webOrderId, newStatus) {
            try {
                const history = getStoredOrderHistory();
                let changed = false;
                history.forEach(order => {
                    if (order.webOrderId === webOrderId || order.id === webOrderId) {
                        order.status = newStatus;
                        order.syncedAt = Date.now();
                        changed = true;
                    }
                });
                if (changed) {
                    localStorage.setItem(ORDER_HISTORY_STORAGE_KEY, JSON.stringify(history));
                    updateOrderHistoryBadge();
                    const historyModal = document.getElementById("historyModal");
                    if (historyModal && historyModal.classList.contains("active")) {
                        renderOrderHistory();
                    }
                }
            } catch (e) {
                console.error("Error actualizando estado en historial:", e);
            }
        }

        async function syncPendingOfflineOrders(manualTrigger = false) {
            if (isSyncingOfflineOrders) return;
            const queue = getOfflineOrdersQueue();
            if (queue.length === 0) {
                if (manualTrigger) {
                    showLiveToast("Cola vacía", "No hay pedidos pendientes de sincronizar.", "info", 3000);
                }
                updateOfflineQueueUI();
                return;
            }

            if (!navigator.onLine) {
                if (manualTrigger) {
                    showLiveToast("Sin Conexión", "No se detecta conexión a internet. Los pedidos se sincronizarán al reconectar.", "warning", 4000);
                }
                updateOfflineQueueUI();
                return;
            }

            if (!db && typeof firebase !== "undefined") {
                try {
                    db = firebase.firestore();
                } catch (e) {}
            }

            if (!db) {
                if (manualTrigger) {
                    showLiveToast("Conectando", "Esperando servicio de base de datos...", "info", 3000);
                }
                return;
            }

            isSyncingOfflineOrders = true;
            updateOfflineQueueUI(true);

            let syncedCount = 0;
            let failedCount = 0;

            for (const item of [...queue]) {
                try {
                    const orderDoc = { ...item.orderDocument };
                    if (orderDoc.status === "Pendiente Sincronización (Offline)" || orderDoc.status === "offline_queued") {
                        orderDoc.status = "Pendiente Validación";
                    }
                    orderDoc.syncedAt = Date.now();

                    if (item.isConsolidation && item.activeOrderInfo && item.activeOrderInfo.docId) {
                        await db.collection("pedidos_web").doc(item.activeOrderInfo.docId).set(orderDoc, { merge: true });
                    } else {
                        await db.collection("pedidos_web").doc(item.webOrderId).set(orderDoc);
                    }

                    removeOrderFromOfflineQueue(item.webOrderId);
                    updateHistoryOrderStatus(item.webOrderId, "Pendiente Validación");
                    syncedCount++;
                    console.log("Pedido offline sincronizado exitosamente:", item.webOrderId);
                } catch (err) {
                    console.error("Error al sincronizar pedido en cola:", item.webOrderId, err);
                    item.retryCount = (item.retryCount || 0) + 1;
                    item.lastError = err.message || "Error de red";
                    failedCount++;
                }
            }

            isSyncingOfflineOrders = false;
            updateOfflineQueueUI();

            if (syncedCount > 0) {
                showLiveToast(
                    "¡Pedidos Sincronizados!",
                    `Se enviaron exitosamente ${syncedCount} comanda(s) guardadas offline a la cocina.`,
                    "success",
                    5000
                );
                try {
                    launchConfettiBurst();
                    playOrderStatusAudioChime("listo");
                } catch (e) {}
                setupCustomerOrdersListener();
            }

            if (failedCount > 0 && manualTrigger) {
                showLiveToast(
                    "Reintento pendiente",
                    `No se pudieron sincronizar ${failedCount} pedido(s). Se reintentará automáticamente al estabilizar la conexión.`,
                    "warning",
                    4000
                );
            }
        }

        function getStoredOrderHistory() {
            try {
                const stored = localStorage.getItem(ORDER_HISTORY_STORAGE_KEY);
                return stored ? JSON.parse(stored) : [];
            } catch (e) {
                console.error("Error reading order history from localStorage:", e);
                return [];
            }
        }

        function saveOrderToHistory(orderDoc) {
            try {
                const history = getStoredOrderHistory();
                history.unshift(orderDoc); // Place most recent on top
                localStorage.setItem(ORDER_HISTORY_STORAGE_KEY, JSON.stringify(history.slice(0, 30))); // Keep max 30
                updateOrderHistoryBadge();
            } catch (e) {
                console.error("Error saving order to localStorage:", e);
            }
        }

        function updateOrderHistoryBadge() {
            const count = getStoredOrderHistory().length;
            const badge = document.getElementById('tabCountHistory');
            if (badge) badge.textContent = count;
        }

        function getLoyaltyTierInfo(totalPoints) {
            if (totalPoints >= 600) {
                return {
                    name: "Platino VIP",
                    icon: "💎",
                    className: "tier-platino",
                    nextTierName: "Máximo Nivel",
                    current: totalPoints,
                    target: 600,
                    percent: 100
                };
            } else if (totalPoints >= 300) {
                return {
                    name: "Oro",
                    icon: "🥇",
                    className: "tier-oro",
                    nextTierName: "Platino VIP (600 pts)",
                    current: totalPoints,
                    target: 600,
                    percent: Math.min(100, Math.round(((totalPoints - 300) / 300) * 100))
                };
            } else if (totalPoints >= 100) {
                return {
                    name: "Plata",
                    icon: "🥈",
                    className: "tier-plata",
                    nextTierName: "Oro (300 pts)",
                    current: totalPoints,
                    target: 300,
                    percent: Math.min(100, Math.round(((totalPoints - 100) / 200) * 100))
                };
            } else {
                return {
                    name: "Bronce",
                    icon: "🥉",
                    className: "tier-bronce",
                    nextTierName: "Plata (100 pts)",
                    current: totalPoints,
                    target: 100,
                    percent: Math.min(100, Math.round((totalPoints / 100) * 100))
                };
            }
        }

        function renderOrderHistory() {
            const container = document.getElementById('historyItemsList');
            const history = getStoredOrderHistory();

            if (history.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 36px 14px; color: var(--text-muted);">
                        <div style="font-size: 36px; margin-bottom: 8px;">📜</div>
                        <h4 style="font-size: 15px; font-weight: 800; color: var(--text-main);">No tienes pedidos anteriores</h4>
                        <p style="font-size: 12px; margin-top: 4px; line-height: 1.4;">
                            Los pedidos que realices desde este dispositivo se guardarán aquí para que puedas acumular <strong>Puntos de Fidelidad</strong> (1 punto por cada Q0.50), consultar su estado y descargar tus recibos en PDF.
                        </p>
                    </div>
                `;
                return;
            }

            // Calculate Loyalty Points (1 point per Q0.50)
            const totalSpent = history.reduce((sum, o) => sum + Number(o.totalAmount || 0), 0);
            const totalLoyaltyPoints = history.reduce((sum, o) => sum + Math.floor(Number(o.totalAmount || 0) / 0.50), 0);
            const tierInfo = getLoyaltyTierInfo(totalLoyaltyPoints);

            const loyaltyCardHtml = `
                <div class="loyalty-card">
                    <div class="loyalty-card-header">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <span class="loyalty-sparkle">⭐</span>
                            <div>
                                <h4 class="loyalty-title">Puntos de Fidelidad Rivera</h4>
                                <p class="loyalty-sub">Ganas 1 punto por cada Q0.50 en tus pedidos</p>
                            </div>
                        </div>
                        <span class="loyalty-tier-badge ${tierInfo.className}">
                            <span>${tierInfo.icon}</span> <span>${tierInfo.name}</span>
                        </span>
                    </div>

                    <div class="loyalty-card-body">
                        <div>
                            <div class="loyalty-points-number">${totalLoyaltyPoints}</div>
                            <div class="loyalty-points-label">Puntos Acumulados</div>
                        </div>
                        <div class="loyalty-stats-grid">
                            <div class="loyalty-stat-item">
                                <span class="loyalty-stat-val">Q${totalSpent.toFixed(2)}</span>
                                <span class="loyalty-stat-lbl">Consumo Total</span>
                            </div>
                            <div class="loyalty-stat-item">
                                <span class="loyalty-stat-val">${history.length}</span>
                                <span class="loyalty-stat-lbl">Órdenes Realizadas</span>
                            </div>
                        </div>
                    </div>

                    <div class="loyalty-progress-box">
                        <div class="loyalty-progress-info">
                            <span>Nivel siguiente: ${tierInfo.nextTierName}</span>
                            <span><strong>${tierInfo.current}/${tierInfo.target} pts</strong> (${tierInfo.percent}%)</span>
                        </div>
                        <div class="loyalty-progress-track">
                            <div class="loyalty-progress-fill" style="width: ${tierInfo.percent}%;"></div>
                        </div>
                    </div>
                </div>
            `;

            const historyCardsHtml = history.map((order, index) => {
                let items = [];
                try {
                    items = typeof order.itemsJson === 'string' ? JSON.parse(order.itemsJson) : (order.items || []);
                } catch (e) {
                    items = [];
                }

                const dateFormatted = order.createdAt 
                    ? new Date(order.createdAt).toLocaleDateString('es-GT', { 
                        day: '2-digit', 
                        month: 'short', 
                        year: 'numeric',
                        hour: '2-digit', 
                        minute: '2-digit' 
                    }) 
                    : "Fecha reciente";

                let statusBadgeClass = "pending";
                let statusText = order.status || "Pendiente Validación";
                const isDelivered = statusText.toLowerCase().includes("entregado") || statusText.toLowerCase().includes("delivered") || statusText.toLowerCase().includes("listo");
                const isOfflineQueued = statusText.toLowerCase().includes("offline") || statusText.toLowerCase().includes("cola") || statusText.toLowerCase().includes("sincroniz");
                
                if (isOfflineQueued) statusBadgeClass = "offline";
                else if (statusText.toLowerCase().includes("cocina")) statusBadgeClass = "cooking";
                else if (isDelivered) statusBadgeClass = "ready";

                const orderTotal = Number(order.totalAmount || 0);
                const orderPoints = Math.floor(orderTotal / 0.50);

                const itemsSummaryRows = items.map(it => `
                    <div style="margin: 3px 0;">
                        <div style="display: flex; justify-content: space-between;">
                            <span>${it.quantity}x ${it.name}</span>
                            <span>Q${Number(it.subtotal || (it.price * it.quantity)).toFixed(2)}</span>
                        </div>
                        ${it.notes ? `<div style="font-size: 11px; color: #64748B; margin-left: 6px;">✍️ <em>${escapeHtml(it.notes)}</em></div>` : ''}
                    </div>
                `).join('');

                const orderJsonEscaped = encodeURIComponent(JSON.stringify(items));
                const orderIdKey = order.webOrderId || order.id;

                return `
                    <div class="history-card" style="--item-idx: ${index};">
                        <div class="history-card-header">
                            <div>
                                <span class="history-order-id">#${orderIdKey}</span>
                                <div class="history-order-date">${dateFormatted} • ${order.origin || 'Mesa'}</div>
                            </div>
                            <span class="history-status-badge ${statusBadgeClass}">
                                <span>${statusBadgeClass === 'offline' ? '📡' : statusBadgeClass === 'pending' ? '⏳' : statusBadgeClass === 'cooking' ? '🍳' : '✅'}</span>
                                <span>${statusText}</span>
                            </span>
                        </div>

                        <div class="history-items-summary">
                            ${itemsSummaryRows}
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px;">
                            <span class="order-loyalty-badge">
                                <span>⭐</span>
                                <span>+${orderPoints} Puntos (1 pt c/ Q0.50)</span>
                            </span>
                            <div class="history-total">
                                Total: Q${orderTotal.toFixed(2)}
                            </div>
                        </div>

                        <div class="history-card-footer" style="margin-top: 8px; border-top: 1px dashed var(--border-color); padding-top: 8px;">
                            <div class="history-actions" style="width: 100%; justify-content: space-between;">
                                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                    <button type="button" class="btn-download-receipt" onclick="downloadPdfReceipt('${orderIdKey}')" title="Descargar Comprobante / Recibo PDF">
                                        <span>📄 Recibo PDF</span>
                                    </button>
                                    ${isOfflineQueued ? `
                                        <button type="button" class="btn-download-receipt" style="color: #C2410C; border-color: #FDBA74; background: #FFF7ED; font-weight: 800;" onclick="syncPendingOfflineOrders(true)" title="Sincronizar este pedido con cocina ahora">
                                            <span>🔄 Sincronizar</span>
                                        </button>
                                    ` : ''}
                                </div>
                                <div style="display: flex; gap: 6px;">
                                    ${isDelivered ? `
                                        <button type="button" class="btn-download-receipt" style="color: #D97706; border-color: #FCD34D; background: #FFFBEB;" onclick="showCustomerFeedbackModal('${orderIdKey}')">
                                            <span>⭐ Calificar</span>
                                        </button>
                                    ` : ''}
                                    <button type="button" class="btn-reorder" onclick="reorderPastItems('${orderJsonEscaped}')">
                                        🔁 Repetir
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            container.innerHTML = loyaltyCardHtml + historyCardsHtml;
        }

        // --- PDF RECEIPT GENERATOR & DOWNLOADER ---
        function downloadPdfReceipt(orderId) {
            const history = getStoredOrderHistory();
            const order = history.find(o => (o.webOrderId || String(o.id)) === String(orderId)) || history[0];

            if (!order) {
                showLiveToast("Error", "No se encontró la información del pedido para generar el recibo.", "error");
                return;
            }

            let items = [];
            try {
                items = typeof order.itemsJson === 'string' ? JSON.parse(order.itemsJson) : (order.items || []);
            } catch (e) {
                items = [];
            }

            const total = Number(order.totalAmount || 0);
            const subtotal = total / 1.10;
            const tip = total - subtotal;
            const pointsEarned = Math.floor(total / 0.50);
            const dateStr = order.createdAt ? new Date(order.createdAt).toLocaleString('es-GT', { dateStyle: 'long', timeStyle: 'short' }) : new Date().toLocaleString('es-GT');
            const receiptId = order.webOrderId || order.id || 'WEB-REC';

            const itemsRowsHtml = items.map(item => `
                <tr style="border-bottom: 1px solid #E2E8F0;">
                    <td style="padding: 8px 6px; font-weight: 700;">${item.quantity}</td>
                    <td style="padding: 8px 6px;">
                        <div><strong>${escapeHtml(item.name)}</strong></div>
                        ${item.notes ? `<div style="font-size: 11px; color: #64748B;">Nota: ${escapeHtml(item.notes)}</div>` : ''}
                    </td>
                    <td style="padding: 8px 6px; text-align: right;">Q${Number(item.price || 0).toFixed(2)}</td>
                    <td style="padding: 8px 6px; text-align: right; font-weight: 700;">Q${Number(item.subtotal || (item.price * item.quantity)).toFixed(2)}</td>
                </tr>
            `).join('');

            const receiptHtml = `
                <!DOCTYPE html>
                <html lang="es">
                <head>
                    <meta charset="UTF-8">
                    <title>Comprobante de Pedido #${receiptId} - Restaurante Rivera</title>
                    <style>
                        * { box-sizing: border-box; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; }
                        body { background: #F8FAFC; padding: 20px; color: #0F172A; display: flex; justify-content: center; }
                        .receipt-wrapper { max-width: 480px; width: 100%; background: white; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); padding: 28px 24px; border: 1px solid #E2E8F0; }
                        .header { text-align: center; border-bottom: 2px dashed #CBD5E1; padding-bottom: 16px; margin-bottom: 16px; }
                        .brand-title { font-size: 22px; font-weight: 800; color: #1E3A8A; margin: 0; }
                        .brand-subtitle { font-size: 12px; color: #64748B; margin: 4px 0 0; }
                        .meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 12.5px; background: #F1F5F9; border-radius: 10px; padding: 12px; margin-bottom: 16px; }
                        .meta-item strong { display: block; font-size: 11px; color: #64748B; text-transform: uppercase; }
                        table { width: 100%; border-collapse: collapse; font-size: 13px; margin-bottom: 16px; }
                        th { background: #F8FAFC; text-align: left; padding: 8px 6px; font-size: 11.5px; text-transform: uppercase; color: #475569; border-bottom: 1.5px solid #CBD5E1; }
                        .totals-box { border-top: 2px dashed #CBD5E1; padding-top: 12px; display: flex; flex-direction: column; gap: 6px; font-size: 13px; }
                        .totals-row { display: flex; justify-content: space-between; }
                        .totals-row.grand-total { font-size: 18px; font-weight: 900; color: #1E3A8A; border-top: 1px solid #E2E8F0; padding-top: 8px; margin-top: 4px; }
                        .loyalty-banner { background: linear-gradient(135deg, #FFFBEB, #FEF3C7); border: 1px solid #FCD34D; border-radius: 10px; padding: 10px; margin-top: 14px; text-align: center; font-size: 12.5px; color: #92400E; font-weight: 700; }
                        .footer { text-align: center; margin-top: 20px; font-size: 11px; color: #94A3B8; border-top: 1px solid #F1F5F9; padding-top: 14px; }
                        .btn-actions { display: flex; gap: 10px; margin-top: 20px; }
                        .btn-print { flex: 1; background: #1E3A8A; color: white; border: none; padding: 12px; border-radius: 10px; font-weight: 700; font-size: 14px; cursor: pointer; }
                        .btn-close { background: #E2E8F0; color: #334155; border: none; padding: 12px 18px; border-radius: 10px; font-weight: 700; cursor: pointer; }
                        @media print {
                            body { background: white; padding: 0; }
                            .receipt-wrapper { box-shadow: none; border: none; padding: 0; }
                            .btn-actions { display: none; }
                        }
                    </style>
                </head>
                <body>
                    <div class="receipt-wrapper">
                        <div class="header">
                            <div style="font-size: 32px; margin-bottom: 4px;">🍽️</div>
                            <h1 class="brand-title">Restaurante Rivera</h1>
                            <p class="brand-subtitle">Auténtica Gastronomía Guatemalteca</p>
                            <p class="brand-subtitle">NIT: 98765432-1 • Tel: +502 5555-1234 • Ciudad de Guatemala</p>
                        </div>

                        <div class="meta-grid">
                            <div class="meta-item">
                                <strong>Comprobante N°</strong>
                                <span>#${receiptId}</span>
                            </div>
                            <div class="meta-item">
                                <strong>Fecha y Hora</strong>
                                <span>${dateStr}</span>
                            </div>
                            <div class="meta-item">
                                <strong>Cliente</strong>
                                <span>${escapeHtml(order.customerName || 'Cliente Rivera')}</span>
                            </div>
                            <div class="meta-item">
                                <strong>Ubicación / Mesa</strong>
                                <span>${escapeHtml(order.origin || order.tableNumber || 'Mesa 1')}</span>
                            </div>
                            <div class="meta-item">
                                <strong>Forma de Pago</strong>
                                <span>${escapeHtml(order.paymentMethod || 'Efectivo')}</span>
                            </div>
                            <div class="meta-item">
                                <strong>Estado de Orden</strong>
                                <span>${escapeHtml(order.status || 'Completado')}</span>
                            </div>
                        </div>

                        <table>
                            <thead>
                                <tr>
                                    <th style="width: 32px;">Cant</th>
                                    <th>Descripción</th>
                                    <th style="text-align: right; width: 75px;">Precio</th>
                                    <th style="text-align: right; width: 85px;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${itemsRowsHtml}
                            </tbody>
                        </table>

                        <div class="totals-box">
                            <div class="totals-row">
                                <span>Subtotal Alimentos y Bebidas:</span>
                                <span>Q${subtotal.toFixed(2)}</span>
                            </div>
                            <div class="totals-row">
                                <span>Propina Voluntaria / Servicio (10%):</span>
                                <span>Q${tip.toFixed(2)}</span>
                            </div>
                            <div class="totals-row grand-total">
                                <span>TOTAL PAGADO:</span>
                                <span>Q${total.toFixed(2)}</span>
                            </div>
                        </div>

                        <div class="loyalty-banner">
                            ⭐ Puntos de Fidelidad Ganados: <strong>+${pointsEarned} Puntos</strong> (1 pt c/ Q0.50)
                        </div>

                        <div class="footer">
                            <div style="font-family: monospace; font-size: 14px; letter-spacing: 2px; margin-bottom: 4px;">||| | |||| | ||||| ||| ||</div>
                            <div>¡Gracias por tu preferencia! • Documento Digital de Control Interno</div>
                            <div>Restaurante Rivera &copy; ${new Date().getFullYear()}</div>
                        </div>

                        <div class="btn-actions">
                            <button class="btn-print" onclick="window.print()">🖨️ Imprimir / Guardar PDF</button>
                            <button class="btn-close" onclick="window.close()">Cerrar</button>
                        </div>
                    </div>
                </body>
                </html>
            `;

            // Open printable receipt in popup window
            const printWindow = window.open('', '_blank');
            if (printWindow) {
                printWindow.document.open();
                printWindow.document.write(receiptHtml);
                printWindow.document.close();
                showLiveToast("📄 Recibo Generado", "Se abrió el comprobante de pago con desglose y puntos de fidelidad.", "success", 3500);
            } else {
                // Fallback: create downloadable file blob
                const blob = new Blob([receiptHtml], { type: 'text/html;charset=utf-8' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Recibo_RestauranteRivera_${receiptId}.html`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showLiveToast("📄 Recibo Descargado", "Descargado comprobante de tu pedido.", "success", 3500);
            }
        }

        function reorderPastItems(itemsJsonEscaped) {
            try {
                const items = JSON.parse(decodeURIComponent(itemsJsonEscaped));
                let addedCount = 0;

                items.forEach(it => {
                    const catalogItem = menuProducts.find(p => p.id === it.id || p.name.toLowerCase() === it.name.toLowerCase());
                    if (catalogItem && catalogItem.isAvailable) {
                        const existing = cart.find(c => c.product.id === catalogItem.id && (c.notes || '') === (it.notes || ''));
                        if (existing) {
                            existing.quantity += it.quantity;
                        } else {
                            cart.push({
                                product: catalogItem,
                                quantity: it.quantity,
                                notes: it.notes || ""
                            });
                        }
                        addedCount += it.quantity;
                    }
                });

                if (addedCount > 0) {
                    updateCartUI();
                    switchModalTab('current');
                    showLiveToast(
                        "🔁 Pedido Replicado",
                        `Se agregaron <strong>${addedCount} productos</strong> a tu orden activa.`,
                        "success",
                        3500
                    );
                } else {
                    showLiveToast(
                        "⚠️ Platillos no disponibles",
                        "Los platillos de esta orden anterior no están disponibles actualmente en el menú.",
                        "warning",
                        4000
                    );
                }
            } catch (e) {
                console.error("Error reordering past items:", e);
            }
        }

        // --- 11. REAL-TIME FORM VALIDATION & CHECKOUT LOGIC ---
        let isFormTouched = false;

        function handleOriginChange() {
            const originSelect = document.getElementById('selectOrigin');
            const addressGroup = document.getElementById('groupCustomerAddress');
            const isDelivery = originSelect.value === 'A Domicilio';

            if (addressGroup) {
                if (isDelivery) {
                    addressGroup.style.display = 'flex';
                    addressGroup.style.animation = 'cartItemSlideUp 0.25s ease-out';
                } else {
                    addressGroup.style.display = 'none';
                }
            }
            validateCustomerOrigin(true);
            validateAllFormFields(true);
            checkAndDisplayTableStatusInCart(true);
        }

        function validateCustomerOrigin(showErrors = true) {
            const originSelect = document.getElementById('selectOrigin');
            const feedback = document.getElementById('originFeedback');
            const icon = document.getElementById('originStatusIcon');
            if (!originSelect || !feedback) return true;

            const val = (originSelect.value || '').trim();

            if (!val) {
                if (showErrors && isFormTouched) {
                    originSelect.classList.remove('is-valid');
                    originSelect.classList.add('is-invalid');
                    feedback.className = 'field-feedback error';
                    feedback.innerHTML = '⚠️ Debes seleccionar una mesa, barra o tipo de entrega.';
                    if (icon) icon.innerHTML = '❌';
                } else {
                    originSelect.classList.remove('is-valid', 'is-invalid');
                    feedback.className = 'field-feedback';
                    feedback.innerHTML = '';
                    if (icon) icon.innerHTML = '';
                }
                return false;
            }

            originSelect.classList.remove('is-invalid');
            originSelect.classList.add('is-valid');
            feedback.className = 'field-feedback success';

            if (val === 'A Domicilio') {
                feedback.innerHTML = '✓ A Domicilio 🛵 (Ingresa la dirección completa abajo)';
            } else if (val.includes('Para Llevar')) {
                feedback.innerHTML = '✓ Para Llevar / Pick-Up en mostrador';
            } else {
                feedback.innerHTML = `✓ Servicio en sala seleccionado (${val})`;
            }
            if (icon) icon.innerHTML = '✅';
            return true;
        }

        function validateCustomerName(showErrors = true) {
            const nameInput = document.getElementById('inputCustomerName');
            const feedback = document.getElementById('nameFeedback');
            const icon = document.getElementById('nameStatusIcon');
            const originSelect = document.getElementById('selectOrigin');
            if (!nameInput || !feedback) return false;

            let val = nameInput.value.trim();
            // Default to table if empty and in table mode
            if (!val && originSelect && originSelect.value && !originSelect.value.includes('A Domicilio')) {
                val = `Cliente ${originSelect.value}`;
                nameInput.value = val;
            }

            const isValid = val.length >= 2 && /^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑüÜ\s.\x27-]+$/.test(val);

            if (val.length === 0) {
                if (showErrors && isFormTouched) {
                    nameInput.classList.remove('is-valid');
                    nameInput.classList.add('is-invalid');
                    feedback.className = 'field-feedback error';
                    feedback.innerHTML = '⚠️ El nombre o mesa es obligatorio.';
                    if (icon) icon.innerHTML = '❌';
                } else {
                    nameInput.classList.remove('is-valid', 'is-invalid');
                    feedback.className = 'field-feedback';
                    feedback.innerHTML = '';
                    if (icon) icon.innerHTML = '';
                }
                return false;
            }

            if (isValid) {
                nameInput.classList.remove('is-invalid');
                nameInput.classList.add('is-valid');
                feedback.className = 'field-feedback success';
                feedback.innerHTML = '✓ Identificación verificada';
                if (icon) icon.innerHTML = '✅';
                return true;
            } else {
                if (showErrors) {
                    nameInput.classList.remove('is-valid');
                    nameInput.classList.add('is-invalid');
                    feedback.className = 'field-feedback error';
                    feedback.innerHTML = '⚠️ Ingresa un nombre o número de mesa válido.';
                    if (icon) icon.innerHTML = '❌';
                }
                return false;
            }
        }

        function validateCustomerPhone(showErrors = true) {
            const phoneInput = document.getElementById('inputCustomerPhone');
            const feedback = document.getElementById('phoneFeedback');
            const icon = document.getElementById('phoneStatusIcon');
            const origin = document.getElementById('selectOrigin')?.value || '';
            if (!phoneInput || !feedback) return false;

            const isDelivery = origin === 'A Domicilio';
            const rawVal = phoneInput.value.trim();
            const digitsOnly = rawVal.replace(/[^0-9]/g, '');

            // Phone is optional for dine-in tables
            if (!isDelivery && rawVal.length === 0) {
                phoneInput.classList.remove('is-invalid');
                feedback.className = 'field-feedback';
                feedback.innerHTML = '<span style="color: var(--text-muted); font-size: 11px;">ℹ️ Opcional para consumo en restaurante</span>';
                if (icon) icon.innerHTML = '';
                return true;
            }

            if (rawVal.length === 0 && isDelivery) {
                if (showErrors && isFormTouched) {
                    phoneInput.classList.remove('is-valid');
                    phoneInput.classList.add('is-invalid');
                    feedback.className = 'field-feedback error';
                    feedback.innerHTML = '⚠️ El teléfono es obligatorio para envíos a domicilio.';
                    if (icon) icon.innerHTML = '❌';
                } else {
                    phoneInput.classList.remove('is-valid', 'is-invalid');
                    feedback.className = 'field-feedback';
                    feedback.innerHTML = '';
                    if (icon) icon.innerHTML = '';
                }
                return false;
            }

            const hasValidFormat = digitsOnly.length >= 8 && digitsOnly.length <= 15;

            if (hasValidFormat) {
                phoneInput.classList.remove('is-invalid');
                phoneInput.classList.add('is-valid');
                feedback.className = 'field-feedback success';
                feedback.innerHTML = '✓ Teléfono verificado (' + digitsOnly.length + ' dígitos)';
                if (icon) icon.innerHTML = '✅';
                return true;
            } else {
                if (showErrors) {
                    phoneInput.classList.remove('is-valid');
                    phoneInput.classList.add('is-invalid');
                    feedback.className = 'field-feedback error';
                    feedback.innerHTML = '⚠️ Ingresa de 8 a 15 dígitos numéricos (Ej. 5555-1234).';
                    if (icon) icon.innerHTML = '❌';
                }
                return false;
            }
        }

        function validateCustomerAddress(showErrors = true) {
            const origin = document.getElementById('selectOrigin')?.value;
            const addressInput = document.getElementById('inputCustomerAddress');
            const feedback = document.getElementById('addressFeedback');
            const icon = document.getElementById('addressStatusIcon');
            if (!addressInput || !feedback) return true;

            const isDelivery = origin === 'A Domicilio';
            const val = addressInput.value.trim();

            if (!isDelivery) {
                addressInput.classList.remove('is-invalid');
                if (val.length > 0) {
                    addressInput.classList.add('is-valid');
                    feedback.className = 'field-feedback success';
                    feedback.innerHTML = '✓ Referencia agregada';
                } else {
                    addressInput.classList.remove('is-valid');
                    feedback.className = 'field-feedback';
                    feedback.innerHTML = '';
                }
                if (icon) icon.innerHTML = '';
                return true;
            }

            // If delivery, address is strictly required (min 6 chars)
            if (val.length >= 6) {
                addressInput.classList.remove('is-invalid');
                addressInput.classList.add('is-valid');
                feedback.className = 'field-feedback success';
                feedback.innerHTML = '✓ Dirección de entrega completa';
                if (icon) icon.innerHTML = '✅';
                return true;
            } else {
                if (showErrors) {
                    addressInput.classList.remove('is-valid');
                    addressInput.classList.add('is-invalid');
                    feedback.className = 'field-feedback error';
                    feedback.innerHTML = '⚠️ Ingresa la dirección completa con calle/zona (mínimo 6 caracteres).';
                    if (icon) icon.innerHTML = '❌';
                }
                return false;
            }
        }

        function validateAllFormFields(showErrors = false) {
            const isOriginValid = validateCustomerOrigin(showErrors);
            const isNameValid = validateCustomerName(showErrors);
            const isPhoneValid = validateCustomerPhone(showErrors);
            const isAddressValid = validateCustomerAddress(showErrors);

            const btnConfirm = document.getElementById('btnConfirmOrder');
            const isAllValid = isOriginValid && isNameValid && isPhoneValid && isAddressValid;

            if (btnConfirm) {
                btnConfirm.classList.remove('disabled-closed');
                if (cart.length > 0) {
                    btnConfirm.disabled = false;
                    btnConfirm.style.opacity = '1';
                    btnConfirm.style.cursor = 'pointer';
                    btnConfirm.innerHTML = `<span>Confirmar y Enviar Pedido</span> ➔`;
                } else {
                    btnConfirm.disabled = true;
                    btnConfirm.style.opacity = '0.6';
                    btnConfirm.style.cursor = 'not-allowed';
                }
            }

            return isAllValid;
        }

        function initFormValidationListeners() {
            const nameInput = document.getElementById('inputCustomerName');
            const phoneInput = document.getElementById('inputCustomerPhone');
            const originSelect = document.getElementById('selectOrigin');
            const addressInput = document.getElementById('inputCustomerAddress');

            [nameInput, phoneInput, addressInput].forEach(inp => {
                if (!inp) return;
                ['input', 'keyup', 'change', 'paste', 'blur', 'focus'].forEach(evt => {
                    inp.addEventListener(evt, () => {
                        isFormTouched = true;
                        validateAllFormFields(true);
                    });
                });
            });

            if (originSelect) {
                ['change', 'input'].forEach(evt => {
                    originSelect.addEventListener(evt, () => {
                        isFormTouched = true;
                        handleOriginChange();
                        validateAllFormFields(true);
                    });
                });
            }
        }

        // --- 12. FIREBASE CLOUD MESSAGING & CLIENT NOTIFICATIONS ---
        let clientFcmToken = null;
        let fcmMessagingInstance = null;
        let activeOrdersTrackingUnsub = null;
        let notifiedStatusTransitions = new Set();

        function initClientFCM() {
            try {
                if (typeof firebase !== 'undefined' && firebase.messaging && firebase.messaging.isSupported()) {
                    fcmMessagingInstance = firebase.messaging();
                    
                    // Register Background Service Worker
                    if ('serviceWorker' in navigator) {
                        navigator.serviceWorker.register('firebase-messaging-sw.js').then((registration) => {
                            if (fcmMessagingInstance.useServiceWorker) {
                                fcmMessagingInstance.useServiceWorker(registration);
                            }
                            console.log("FCM Service Worker registrado exitosamente.");
                        }).catch(swErr => {
                            console.warn("FCM Service Worker fallback:", swErr);
                        });
                    }

                    // Foreground FCM Message Listener
                    fcmMessagingInstance.onMessage((payload) => {
                        console.log("FCM Notificación en primer plano recibida:", payload);
                        const title = payload.notification?.title || payload.data?.title || "🍽️ Actualización de tu Pedido";
                        const body = payload.notification?.body || payload.data?.body || "El estado de tu orden ha cambiado.";
                        const orderId = payload.data?.orderId || "pedido";
                        const status = payload.data?.status || "Listo";

                        showOrderStatusCelebration(orderId, status, body);
                    });
                }
            } catch (e) {
                console.warn("FCM no disponible en este entorno:", e);
            }

            // Check if notification permission was previously granted
            updateNotifButtonUI();
        }

        async function toggleNotificationPermission() {
            const btn = document.getElementById('btnToggleNotif');
            if (!('Notification' in window)) {
                showLiveToast("Aviso", "Tu navegador no soporta notificaciones push nativas.", "info", 4000);
                return;
            }

            try {
                const permission = await Notification.requestPermission();
                if (permission === 'granted') {
                    showLiveToast("🔔 Push Activadas", "Recibirás alertas inmediatas cuando tu orden pase a Cocina o vaya En Camino.", "success", 4500);
                    
                    if (fcmMessagingInstance) {
                        try {
                            clientFcmToken = await fcmMessagingInstance.getToken({
                                vapidKey: "BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZ_WJJ5_mock_vapid_key"
                            });
                            console.log("FCM Token del cliente obtenido:", clientFcmToken);
                            localStorage.setItem('fcm_client_token', clientFcmToken);
                        } catch (tokErr) {
                            console.log("Token FCM fallback local:", tokErr.message);
                            clientFcmToken = "fcm-client-mock-" + Date.now();
                        }
                    }
                    updateNotifButtonUI();
                } else {
                    showLiveToast("Notificaciones Bloqueadas", "Puedes activarlas desde la configuración de tu navegador.", "warning", 4000);
                    updateNotifButtonUI();
                }
            } catch (err) {
                console.warn("Error solicitando permisos de notificación:", err);
            }
        }

        function updateNotifButtonUI() {
            const btn = document.getElementById('btnToggleNotif');
            const title = document.getElementById('notifStatusTitle');
            const subtitle = document.getElementById('notifStatusSubtitle');
            if (!btn) return;

            if ('Notification' in window && Notification.permission === 'granted') {
                btn.className = 'btn-toggle-notif active';
                btn.innerHTML = '✓ Activas';
                if (title) title.innerText = '🔔 Notificaciones Push Activas';
                if (subtitle) subtitle.innerText = 'Te avisaremos con sonido y alerta en segundo plano cuando cambie a Cocina, En Camino o Listo.';
            } else {
                btn.className = 'btn-toggle-notif';
                btn.innerHTML = 'Activar Push';
                if (title) title.innerText = 'Notificaciones Push en Tiempo Real';
                if (subtitle) subtitle.innerText = 'Recibe alertas push en tu dispositivo cuando tu pedido pase a Cocina 👨‍🍳 o vaya En Camino 🛵.';
            }
        }

        // Web Audio API Status Chime Synthesis (Cocina, Camino, Listo, Entregado)
        function playOrderStatusAudioChime(statusType = 'listo') {
            try {
                const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                if (!AudioContextClass) return;
                const audioCtx = new AudioContextClass();
                const now = audioCtx.currentTime;
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();

                osc.connect(gain);
                gain.connect(audioCtx.destination);

                const type = (statusType || '').toLowerCase();

                if (type.includes('cocina') || type.includes('preparaci')) {
                    // Double medium blip for kitchen start: E5 -> G#5
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(659.25, now);
                    osc.frequency.setValueAtTime(830.61, now + 0.15);

                    gain.gain.setValueAtTime(0, now);
                    gain.gain.linearRampToValueAtTime(0.25, now + 0.04);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.6);

                    osc.start(now);
                    osc.stop(now + 0.65);
                } else if (type.includes('camino') || type.includes('ruta') || type.includes('repartidor')) {
                    // Upward dynamic transit chime: F5 -> A5 -> C6
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(698.46, now);
                    osc.frequency.setValueAtTime(880.00, now + 0.12);
                    osc.frequency.setValueAtTime(1046.50, now + 0.24);

                    gain.gain.setValueAtTime(0, now);
                    gain.gain.linearRampToValueAtTime(0.25, now + 0.03);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.75);

                    osc.start(now);
                    osc.stop(now + 0.8);
                } else if (type.includes('entregado') || type.includes('completado')) {
                    // Warm gentle chime: G5 -> C6
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(783.99, now);
                    osc.frequency.setValueAtTime(1046.50, now + 0.15);

                    gain.gain.setValueAtTime(0, now);
                    gain.gain.linearRampToValueAtTime(0.25, now + 0.04);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.7);

                    osc.start(now);
                    osc.stop(now + 0.75);
                } else {
                    // Fanfare triad for ready: D5 -> F#5 -> A5 -> D6
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(587.33, now);
                    osc.frequency.setValueAtTime(739.99, now + 0.12);
                    osc.frequency.setValueAtTime(880.00, now + 0.24);
                    osc.frequency.setValueAtTime(1174.66, now + 0.36);

                    gain.gain.setValueAtTime(0, now);
                    gain.gain.linearRampToValueAtTime(0.3, now + 0.05);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.9);

                    osc.start(now);
                    osc.stop(now + 0.95);
                }
            } catch (e) {
                console.log("Audio chime playback:", e);
            }
        }

        function showOrderStatusCelebration(orderId, statusText, customDesc = null) {
            const banner = document.getElementById('orderReadyBanner');
            const titleEl = document.getElementById('orderReadyTitle');
            const descEl = document.getElementById('orderReadyDesc');
            const iconEl = document.getElementById('orderReadyIcon');

            const sLower = (statusText || '').toLowerCase();
            let title = `🍽️ Actualización de Pedido #${orderId}`;
            let desc = customDesc || `Tu pedido ha cambiado de estado a ${statusText}.`;
            let icon = "🍽️";

            if (sLower.includes('cocina') || sLower.includes('preparaci')) {
                title = `👨‍🍳 ¡Pedido #${orderId} en Cocina!`;
                desc = customDesc || `Tu orden ha sido aceptada y nuestro chef ya está preparando tus platillos recién hechos.`;
                icon = "👨‍🍳";
            } else if (sLower.includes('camino') || sLower.includes('ruta') || sLower.includes('repartidor')) {
                title = `🛵 ¡Pedido #${orderId} en Camino!`;
                desc = customDesc || `Tu comida está empaquetada y el repartidor va en ruta hacia tu dirección.`;
                icon = "🛵";
            } else if (sLower.includes('listo') || sLower.includes('servir')) {
                title = `🎉 ¡Tu Pedido #${orderId} está LISTO!`;
                desc = customDesc || `Tu comida recién preparada está lista para ser retirada o servida en tu mesa. ¡Buen provecho!`;
                icon = "🍽️";
            } else if (sLower.includes('entregado') || sLower.includes('completado')) {
                title = `🎁 ¡Pedido #${orderId} Entregado!`;
                desc = customDesc || `Tu orden ha sido entregada con éxito. ¡Muchas gracias por tu preferencia y buen provecho!`;
                icon = "🎁";
            }

            if (titleEl) titleEl.innerText = title;
            if (descEl) descEl.innerText = desc;
            if (iconEl) iconEl.innerText = icon;

            if (banner) {
                banner.classList.add('show');
            }

            // Audio Alert
            playOrderStatusAudioChime(sLower);

            // Native Browser Push Notification
            if ('Notification' in window && Notification.permission === 'granted') {
                try {
                    new Notification(title, {
                        body: desc,
                        icon: "images/cat_fuertes.jpg"
                    });
                } catch(nErr) {
                    console.log("Notification trigger:", nErr);
                }
            }
        }

        function dismissOrderReadyBanner() {
            const banner = document.getElementById('orderReadyBanner');
            if (banner) {
                banner.classList.remove('show');
            }
        }

        // Live Real-Time Multi-Order Status Monitoring for Customers
        function setupCustomerOrdersListener() {
            if (!db) return;

            try {
                // Subscribe to updates in Firestore for web orders
                if (activeOrdersTrackingUnsub) {
                    activeOrdersTrackingUnsub();
                }

                activeOrdersTrackingUnsub = db.collection("pedidos_web")
                    .orderBy("createdAt", "desc")
                    .limit(20)
                    .onSnapshot((snapshot) => {
                        const localOrders = getOrderHistory();
                        if (localOrders.length === 0) return;

                        const localOrderIds = new Set(localOrders.map(o => String(o.webOrderId || o.id)));

                        snapshot.docChanges().forEach((change) => {
                            const data = change.doc.data();
                            const docOrderId = String(data.webOrderId || change.doc.id);

                            if (localOrderIds.has(docOrderId)) {
                                const currentStatus = data.status || "Pendiente";
                                const transitionKey = `${docOrderId}_${currentStatus}`;

                                // Update local storage representation
                                const updatedLocalOrders = localOrders.map(o => {
                                    if (String(o.webOrderId || o.id) === docOrderId) {
                                        return { ...o, status: currentStatus };
                                    }
                                    return o;
                                });
                                localStorage.setItem('restaurante_customer_orders', JSON.stringify(updatedLocalOrders));
                                renderOrderHistoryList();

                                // Check status transitions: Cocina, En Camino, Listo, Entregado
                                const statusLower = currentStatus.toLowerCase();
                                const isSignificant = statusLower.includes("cocina") || 
                                                      statusLower.includes("preparaci") || 
                                                      statusLower.includes("camino") || 
                                                      statusLower.includes("ruta") || 
                                                      statusLower.includes("listo") || 
                                                      statusLower.includes("entregado");

                                if (isSignificant && !notifiedStatusTransitions.has(transitionKey)) {
                                    notifiedStatusTransitions.add(transitionKey);
                                    showOrderStatusCelebration(docOrderId, currentStatus);

                                    // If order is delivered, automatically trigger customer feedback modal after celebration
                                    if (statusLower.includes("entregado") || statusLower.includes("delivered")) {
                                        setTimeout(() => {
                                            showCustomerFeedbackModal(docOrderId, data.customerName || '');
                                        }, 1800);
                                    }
                                }
                            }
                        });
                    }, (err) => {
                        console.warn("Error en tracking en tiempo real de pedidos:", err);
                    });
            } catch (e) {
                console.warn("FCM Customer live order tracking error:", e);
            }
        }

        // --- 13. CUSTOMER AUTOFILL, CONFETTI, REAL-TIME TABLE CHECK & ORDER CHECKOUT ---

        // Customer Info Auto-Fill Persistence (localStorage)
        function loadSavedCustomerInfo() {
            try {
                const savedName = localStorage.getItem('restaurante_customer_name');
                const savedPhone = localStorage.getItem('restaurante_customer_phone');
                const savedAddress = localStorage.getItem('restaurante_customer_address');

                const nameInput = document.getElementById('inputCustomerName');
                const phoneInput = document.getElementById('inputCustomerPhone');
                const addressInput = document.getElementById('inputCustomerAddress');
                const badge = document.getElementById('autofillBadge');

                let wasAutofilled = false;

                if (nameInput && savedName && (!nameInput.value || nameInput.value.trim().length === 0)) {
                    nameInput.value = savedName;
                    wasAutofilled = true;
                }
                if (phoneInput && savedPhone && (!phoneInput.value || phoneInput.value.trim().length === 0)) {
                    phoneInput.value = savedPhone;
                    wasAutofilled = true;
                }
                if (addressInput && savedAddress && (!addressInput.value || addressInput.value.trim().length === 0)) {
                    addressInput.value = savedAddress;
                }

                if (badge) {
                    badge.style.display = wasAutofilled ? 'inline-flex' : 'none';
                }

                if (wasAutofilled) {
                    validateAllFormFields(false);
                }
            } catch (e) {
                console.warn("Error cargando datos de cliente guardados:", e);
            }
        }

        function saveCustomerInfoToStorage(name, phone, address) {
            try {
                if (name && name.trim().length >= 3) {
                    localStorage.setItem('restaurante_customer_name', name.trim());
                }
                if (phone && phone.trim().length >= 8) {
                    localStorage.setItem('restaurante_customer_phone', phone.trim());
                }
                if (address && address.trim().length >= 6) {
                    localStorage.setItem('restaurante_customer_address', address.trim());
                }
            } catch (e) {
                console.warn("Error persistiendo datos de cliente:", e);
            }
        }

        // --- Celebration Confetti Canvas & Confirmation Bubble Physics ---
        let confettiAnimationId = null;

        function launchConfettiBurst() {
            const canvas = document.getElementById('confettiCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            if (!ctx) return;

            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            canvas.style.display = 'block';

            if (confettiAnimationId) {
                cancelAnimationFrame(confettiAnimationId);
            }

            const colors = ['#0D9488', '#14B8A6', '#F97316', '#FB923C', '#F59E0B', '#10B981', '#6366F1', '#EC4899', '#3B82F6'];
            const particleCount = 140;
            const particles = [];

            for (let i = 0; i < particleCount; i++) {
                const side = i % 2 === 0 ? -1 : 1;
                const originX = side === -1 ? window.innerWidth * 0.2 : window.innerWidth * 0.8;
                const originY = window.innerHeight * 0.65;

                particles.push({
                    x: originX,
                    y: originY,
                    vx: (Math.random() * 8 + 3) * (side === -1 ? 1 : -1) + (Math.random() - 0.5) * 6,
                    vy: -(Math.random() * 14 + 9),
                    size: Math.random() * 8 + 5,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    rotation: Math.random() * 360,
                    rotationSpeed: (Math.random() - 0.5) * 12,
                    gravity: 0.38,
                    drag: 0.975,
                    shape: Math.random() > 0.4 ? 'rect' : 'circle',
                    opacity: 1,
                    fadeSpeed: Math.random() * 0.005 + 0.007
                });
            }

            const startTime = Date.now();
            const duration = 2700;

            function renderConfetti() {
                const elapsed = Date.now() - startTime;
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                let activeCount = 0;
                particles.forEach(p => {
                    if (p.opacity > 0) {
                        p.x += p.vx;
                        p.y += p.vy;
                        p.vy += p.gravity;
                        p.vx *= p.drag;
                        p.rotation += p.rotationSpeed;
                        p.opacity -= p.fadeSpeed;

                        if (p.opacity > 0) {
                            activeCount++;
                            ctx.save();
                            ctx.translate(p.x, p.y);
                            ctx.rotate((p.rotation * Math.PI) / 180);
                            ctx.globalAlpha = Math.max(0, p.opacity);
                            ctx.fillStyle = p.color;

                            if (p.shape === 'rect') {
                                ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
                            } else {
                                ctx.beginPath();
                                ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
                                ctx.fill();
                            }
                            ctx.restore();
                        }
                    }
                });

                if (activeCount > 0 && elapsed < duration) {
                    confettiAnimationId = requestAnimationFrame(renderConfetti);
                } else {
                    ctx.clearRect(0, 0, canvas.width, canvas.height);
                    canvas.style.display = 'none';
                }
            }

            renderConfetti();
        }

        function launchConfirmationBubbles(originX, originY) {
            const emojis = ['🎉', '✨', '🍽️', '🔥', '🛵', '⭐', '💫', '👍', '😋'];
            const count = 10;

            for (let i = 0; i < count; i++) {
                const bubble = document.createElement('div');
                bubble.className = 'confirm-bubble';
                bubble.textContent = emojis[i % emojis.length];

                const angle = (Math.PI * 2 / count) * i + (Math.random() - 0.5) * 0.6;
                const distance = Math.random() * 75 + 50;
                const targetX = Math.cos(angle) * distance;
                const targetY = Math.sin(angle) * distance - 40;

                bubble.style.left = `${originX || (window.innerWidth / 2)}px`;
                bubble.style.top = `${originY || (window.innerHeight / 2)}px`;
                bubble.style.setProperty('--bx', `${targetX}px`);
                bubble.style.setProperty('--by', `${targetY}px`);

                document.body.appendChild(bubble);

                setTimeout(() => {
                    if (bubble.parentNode) {
                        bubble.parentNode.removeChild(bubble);
                    }
                }, 1000);
            }
        }

        // --- Reusable Comanda Calculation Helper ---
        function calculateOrderPricing(itemsList, tipPercentage = 0.10) {
            const subtotal = (itemsList || []).reduce((acc, item) => {
                const p = Number(item.price || item.unitPrice || 0);
                const q = Number(item.quantity || 1);
                return acc + (p * q);
            }, 0);
            const tip = subtotal * tipPercentage;
            const grandTotal = subtotal + tip;
            return {
                subtotal: subtotal,
                tip: tip,
                tipPercentage: tipPercentage,
                grandTotal: grandTotal
            };
        }

        // --- Real-Time Firestore Table Active Order Checker & Cart Verification ---
        let activeTableProceedCallback = null;

        async function checkTableHasActiveOrder(tableOrigin) {
            if (!tableOrigin || tableOrigin.includes("Para Llevar") || tableOrigin.includes("A Domicilio")) {
                return null;
            }

            const cleanOrigin = tableOrigin.trim().toLowerCase();
            const activeStatuses = [
                "abierto", "pendiente", "pendiente validación", "en cocina",
                "en proceso", "en preparación", "listo para cobrar",
                "listo_para_cobrar", "por_cobrar", "por cobrar", "finalizado"
            ];

            try {
                if (db) {
                    // 1. Check in pedidos_web
                    const snapshotWeb = await withTimeout(db.collection("pedidos_web").get(), 2500);
                    for (const doc of snapshotWeb.docs) {
                        const data = doc.data();
                        const orig = (data.origin || data.tableNumber || "").trim().toLowerCase();
                        const status = (data.status || "").trim().toLowerCase();
                        const isMatch = orig === cleanOrigin || orig === `mesa ${cleanOrigin}` || cleanOrigin === `mesa ${orig}`;
                        if (isMatch && activeStatuses.some(st => status.includes(st))) {
                            let items = [];
                            try {
                                if (Array.isArray(data.items)) items = data.items;
                                else if (typeof data.itemsJson === 'string') items = JSON.parse(data.itemsJson);
                            } catch (e) { items = []; }

                            return {
                                source: "pedidos_web",
                                docId: doc.id,
                                docRef: doc.ref,
                                rawDoc: data,
                                existingItems: items,
                                orderId: data.webOrderId || doc.id,
                                status: data.status || "Pendiente Validación",
                                customerName: data.customerName || "Cliente",
                                totalAmount: Number(data.totalAmount || 0),
                                notes: data.notes || "",
                                createdAt: data.createdAt || null
                            };
                        }
                    }

                    // 2. Check in native POS table orders (collection 'orders' and 'pedidos')
                    const collectionsToCheck = ["orders", "pedidos"];
                    for (const colName of collectionsToCheck) {
                        const snapshotNative = await withTimeout(db.collection(colName).get(), 2500);
                        for (const doc of snapshotNative.docs) {
                            const data = doc.data();
                            const orig = (data.tableNumber || data.origin || "").trim().toLowerCase();
                            const status = (data.status || "").trim().toLowerCase();
                            const isMatch = orig === cleanOrigin || orig === `mesa ${cleanOrigin}` || cleanOrigin === `mesa ${orig}`;
                            if (isMatch && activeStatuses.some(st => status.includes(st))) {
                                let items = [];
                                try {
                                    if (Array.isArray(data.items)) items = data.items;
                                    else if (typeof data.itemsJson === 'string') items = JSON.parse(data.itemsJson);
                                } catch (e) { items = []; }

                                return {
                                    source: colName,
                                    docId: doc.id,
                                    docRef: doc.ref,
                                    rawDoc: data,
                                    existingItems: items,
                                    orderId: data.orderNumber || data.id || doc.id,
                                    status: data.status || "En Cocina",
                                    customerName: data.customerName || data.waiterName || "Mesa Activa",
                                    totalAmount: Number(data.totalAmount || 0),
                                    notes: data.generalNotes || data.notes || "",
                                    createdAt: data.createdAt || null
                                };
                            }
                        }
                    }
                } else {
                    // Local Storage fallback check
                    const localOrders = JSON.parse(localStorage.getItem('pedidos_web_cache') || '[]');
                    const found = localOrders.find(o => {
                        const orig = (o.origin || o.tableNumber || '').trim().toLowerCase();
                        const status = (o.status || '').trim().toLowerCase();
                        return (orig === cleanOrigin || orig === `mesa ${cleanOrigin}`) &&
                               !['entregado', 'cancelado', 'pagado'].includes(status);
                    });
                    if (found) {
                        return {
                            source: "local",
                            orderId: found.webOrderId || found.id,
                            status: found.status || "Pendiente",
                            customerName: found.customerName || "Cliente",
                            totalAmount: Number(found.totalAmount || 0),
                            rawDoc: found,
                            existingItems: typeof found.itemsJson === 'string' ? JSON.parse(found.itemsJson || '[]') : (found.items || [])
                        };
                    }
                }
            } catch (err) {
                console.warn("Error verificando ocupación de mesa en tiempo real:", err);
            }
            return null;
        }

        async function checkAndDisplayTableStatusInCart(showToast = false) {
            const originSelect = document.getElementById('selectOrigin');
            const origin = originSelect ? originSelect.value : "";
            const noticeBox = document.getElementById('tableActiveOrderNotice');
            const noticeTitle = document.getElementById('tableActiveOrderNoticeTitle');
            const noticeMsg = document.getElementById('tableActiveOrderNoticeMsg');
            const btnConfirm = document.getElementById('btnConfirmOrder');

            if (!origin || origin.includes("Para Llevar") || origin.includes("A Domicilio")) {
                if (noticeBox) noticeBox.style.display = 'none';
                if (btnConfirm && cart.length > 0) {
                    btnConfirm.innerHTML = `<span>Confirmar y Enviar Pedido</span> ➔`;
                }
                return null;
            }

            const activeOrder = await checkTableHasActiveOrder(origin);
            if (activeOrder) {
                if (noticeBox) {
                    noticeBox.style.display = 'flex';
                    if (noticeTitle) noticeTitle.textContent = `⚠️ ${origin} ya cuenta con una Orden Activa (#${activeOrder.orderId})`;
                    if (noticeMsg) {
                        noticeMsg.innerHTML = `Esta mesa tiene una cuenta en estado <strong>${activeOrder.status}</strong> por un total actual de <strong>Q${Number(activeOrder.totalAmount || 0).toFixed(2)}</strong>. Tus nuevos platillos se sumarán a la comanda existente para evitar duplicar pedidos.`;
                    }
                }
                if (btnConfirm && cart.length > 0) {
                    btnConfirm.innerHTML = `<span>➕ Sumar a Comanda Existente (#${activeOrder.orderId})</span> ➔`;
                }
                if (showToast) {
                    showLiveToast(
                        `ℹ️ ${origin} con Orden Activa`,
                        `Esta mesa ya tiene una comanda abierta (#${activeOrder.orderId}). Los platos se agregarán a la misma cuenta.`,
                        "warning",
                        4000
                    );
                }
                return activeOrder;
            } else {
                if (noticeBox) noticeBox.style.display = 'none';
                if (btnConfirm && cart.length > 0) {
                    btnConfirm.innerHTML = `<span>Confirmar y Enviar Pedido</span> ➔`;
                }
                return null;
            }
        }

        function showTableOccupancyAlertModal(tableOrigin, orderInfo, onProceedAsAdditional) {
            const backdrop = document.getElementById('tableOccupiedBackdrop');
            const numText = document.getElementById('tableOccupiedNumText');
            const detailsBox = document.getElementById('tableOccupiedOrderDetails');
            const btnProceed = document.getElementById('btnProceedAdditionalComanda');

            if (numText) numText.textContent = tableOrigin;
            if (detailsBox) {
                detailsBox.innerHTML = `
                    <div><strong>Orden Activa:</strong> #${orderInfo.orderId}</div>
                    <div><strong>Estado:</strong> ${orderInfo.status}</div>
                    <div><strong>Cliente:</strong> ${escapeHtml(orderInfo.customerName || 'Mesa')}</div>
                    <div><strong>Monto actual:</strong> Q${Number(orderInfo.totalAmount || 0).toFixed(2)}</div>
                `;
            }

            activeTableProceedCallback = onProceedAsAdditional;

            if (btnProceed) {
                btnProceed.onclick = () => {
                    closeTableOccupancyModal();
                    if (activeTableProceedCallback) {
                        activeTableProceedCallback();
                    }
                };
            }

            if (backdrop) {
                backdrop.classList.add('open');
            }
        }

        function closeTableOccupancyModal() {
            const backdrop = document.getElementById('tableOccupiedBackdrop');
            if (backdrop) {
                backdrop.classList.remove('open');
            }
            activeTableProceedCallback = null;
        }

        // --- SUBMIT WEB ORDER ---
        async function submitWebOrder(isConfirmedAdditional = false) {
            if (cart.length === 0) return;
            isFormTouched = true;

            // 1. Verificación de Horario y Estado del Restaurante (Módulo Gerente)
            const schedule = getBusinessScheduleInfo();
            if (!schedule.isOpen) {
                showLiveToast(
                    "🔒 Restaurante Cerrado",
                    schedule.alertMessage || "En este momento el restaurante está cerrado para recibir pedidos.",
                    "warning",
                    6000
                );
                return;
            }

            // 2. Control estricto de disponibilidad de platillos en catálogo
            const unavailableItems = cart.filter(c => {
                const liveItem = menuProducts.find(p => p.id === c.product.id);
                return !liveItem || !liveItem.isAvailable;
            });

            if (unavailableItems.length > 0) {
                const unavailableNames = unavailableItems.map(c => c.product.name).join(', ');
                cart = cart.filter(c => {
                    const liveItem = menuProducts.find(p => p.id === c.product.id);
                    return liveItem && liveItem.isAvailable;
                });
                updateCartUI();
                renderCartModalItems();
                showLiveToast(
                    "⚠️ No se pudo enviar el pedido",
                    `Los siguientes platillos ya no están disponibles en cocina: <strong>${unavailableNames}</strong>. Han sido retirados de tu orden.`,
                    "error",
                    7000
                );
                return;
            }

            // 3. Separación de Flujos: Pedidos por Mesa vs Pedidos por WhatsApp
            let origin = "";
            let customerName = "";
            let customerPhone = "";
            let customerAddress = "";
            let paymentMethod = "Efectivo al recibir";
            let notes = "";
            let mapLink = "";
            let writtenAddress = "";

            if (currentOrderFlow === 'whatsapp') {
                const isWaValid = validateWhatsappFields(true);
                if (!isWaValid) {
                    const firstInvalid = document.querySelector('#flowContainerWhatsapp .form-input.is-invalid, #flowContainerWhatsapp textarea.is-invalid');
                    if (firstInvalid) {
                        firstInvalid.focus();
                        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                    showLiveToast(
                        "⚠️ Datos Incompletos para WhatsApp",
                        "Por favor completa Nombre, Teléfono y Ubicación 2 (dirección escrita) antes de enviar.",
                        "error",
                        5000
                    );
                    return;
                }

                customerName = (document.getElementById('inputWhatsappName')?.value || "").trim();
                customerPhone = (document.getElementById('inputWhatsappPhone')?.value || "").trim();
                mapLink = (document.getElementById('inputWhatsappMapLink')?.value || "").trim();
                writtenAddress = (document.getElementById('inputWhatsappAddress')?.value || "").trim();
                customerAddress = writtenAddress + (mapLink ? `\n📍 Ubicación GPS (Maps/Waze): ${mapLink}` : '');
                paymentMethod = document.getElementById('selectPaymentMethod')?.value || "Efectivo al recibir";
                notes = (document.getElementById('inputWhatsappNotes')?.value || "").trim();
                origin = "A Domicilio";
            } else {
                // Pedidos por mesa
                origin = getActiveSelectedTable();
                customerName = (document.getElementById('inputCustomerName')?.value || "").trim();
                if (!customerName) {
                    customerName = `Cliente ${origin}`;
                }
                customerPhone = "";
                customerAddress = "";
                paymentMethod = "En Mesa / Comanda";
                notes = (document.getElementById('inputGeneralNotes')?.value || "").trim();
            }

            // 4. Para pedidos en mesa: Verificar si ya existe orden activa
            let activeOrderOnTable = null;
            if (currentOrderFlow === 'mesa' && !isConfirmedAdditional) {
                activeOrderOnTable = await checkTableHasActiveOrder(origin);
                if (activeOrderOnTable) {
                    showTableOccupancyAlertModal(origin, activeOrderOnTable, () => {
                        submitWebOrder(true);
                    });
                    return;
                }
            }

            const isConsolidation = Boolean(activeOrderOnTable);
            if (isConsolidation || isConfirmedAdditional) {
                notes = notes ? `[Comanda Adicional] ${notes}` : `[Comanda Adicional]`;
            }

            // Mapeo de ítems para comanda y cocina
            const orderItemsPayload = cart.map(c => ({
                id: c.product.id,
                name: c.product.name,
                category: c.product.category,
                price: c.product.price,
                quantity: c.quantity,
                subtotal: c.product.price * c.quantity,
                notes: (c.notes || "").trim(),
                kitchenStatus: "PENDIENTE",
                estado_cocina: "pendiente",
                createdAt: Date.now()
            }));

            const btnConfirm = document.getElementById('btnConfirmOrder');
            const btnRect = btnConfirm ? btnConfirm.getBoundingClientRect() : { left: window.innerWidth/2, top: window.innerHeight/2, width: 0, height: 0 };
            if (btnConfirm) {
                btnConfirm.disabled = true;
                btnConfirm.innerHTML = `<span>Enviando Pedido...</span>`;
            }

            const isCurrentlyOffline = !navigator.onLine;
            let finalOrderId = "";
            let finalGrandTotal = 0;
            let finalOrderPayload = [];

            if (isConsolidation && activeOrderOnTable) {
                // Actualizar orden consolidada existente
                const existingItems = (activeOrderOnTable.existingItems || []).map(it => ({
                    ...it,
                    kitchenStatus: it.kitchenStatus || it.estado_cocina || "FINALIZADO",
                    estado_cocina: it.estado_cocina || it.kitchenStatus || "finalizado"
                }));
                const mergedItems = [...existingItems, ...orderItemsPayload];
                const recalculated = calculateOrderPricing(mergedItems, 0.10);
                finalGrandTotal = recalculated.grandTotal;
                finalOrderId = activeOrderOnTable.orderId;
                finalOrderPayload = mergedItems;

                const existingNotes = activeOrderOnTable.notes || "";
                const mergedNotes = existingNotes 
                    ? (existingNotes.includes(notes) ? existingNotes : `${existingNotes} | ${notes}`)
                    : notes;

                const updateData = {
                    id: Date.now(),
                    webOrderId: finalOrderId,
                    origin: origin,
                    tableNumber: origin,
                    customerName: customerName,
                    customerPhone: customerPhone,
                    deliveryAddress: customerAddress,
                    totalAmount: recalculated.grandTotal,
                    status: isCurrentlyOffline ? "Pendiente Sincronización (Offline)" : "Pendiente Validación",
                    notes: mergedNotes,
                    generalNotes: mergedNotes,
                    orderFlow: currentOrderFlow,
                    isAdditional: true,
                    updatedAt: Date.now(),
                    createdAt: activeOrderOnTable.createdAt || Date.now()
                };

                if (activeOrderOnTable.source === "pedidos_web") {
                    updateData.itemsJson = JSON.stringify(mergedItems);
                } else {
                    updateData.items = mergedItems;
                }

                if (isCurrentlyOffline) {
                    addOrderToOfflineQueue(updateData, true, activeOrderOnTable);
                    saveOrderToHistory(updateData);
                    saveCustomerInfoToStorage(customerName, customerPhone, customerAddress);
                    launchConfettiBurst();
                    launchConfirmationBubbles(btnRect.left + btnRect.width / 2, btnRect.top + btnRect.height / 2);
                    playOrderStatusAudioChime('listo');
                    showOrderSuccessScreen(finalOrderId, customerName, origin, customerAddress, finalGrandTotal, orderItemsPayload, paymentMethod, notes, true);
                    cart = [];
                    updateCartUI();
                    showLiveToast("Comanda Guardada Offline", "Sin conexión. Se sincronizará automáticamente al recuperar la señal.", "warning", 5000);
                    return;
                }

                try {
                    if (activeOrderOnTable.docRef) {
                        await activeOrderOnTable.docRef.set(updateData, { merge: true });
                    } else if (db) {
                        await withTimeout(db.collection("pedidos_web").doc(finalOrderId).set(updateData, { merge: true }), 4000);
                    } else {
                        addOrderToOfflineQueue(updateData, true, activeOrderOnTable);
                    }
                    saveOrderToHistory(updateData);
                    saveCustomerInfoToStorage(customerName, customerPhone, customerAddress);
                    setupCustomerOrdersListener();
                    launchConfettiBurst();
                    launchConfirmationBubbles(btnRect.left + btnRect.width / 2, btnRect.top + btnRect.height / 2);
                    playOrderStatusAudioChime('listo');
                    showOrderSuccessScreen(finalOrderId, customerName, origin, customerAddress, finalGrandTotal, orderItemsPayload, paymentMethod, notes, false);
                    cart = [];
                    updateCartUI();
                } catch (netErr) {
                    console.warn("Fallo de red al actualizar comanda, encolando en persistencia offline:", netErr);
                    updateData.status = "Pendiente Sincronización (Offline)";
                    addOrderToOfflineQueue(updateData, true, activeOrderOnTable);
                    saveOrderToHistory(updateData);
                    saveCustomerInfoToStorage(customerName, customerPhone, customerAddress);
                    launchConfettiBurst();
                    launchConfirmationBubbles(btnRect.left + btnRect.width / 2, btnRect.top + btnRect.height / 2);
                    playOrderStatusAudioChime('listo');
                    showOrderSuccessScreen(finalOrderId, customerName, origin, customerAddress, finalGrandTotal, orderItemsPayload, paymentMethod, notes, true);
                    cart = [];
                    updateCartUI();
                    showLiveToast("Guardado en Cola Offline", "Se interrumpió la red. Tu comanda se enviará al reconectar.", "warning", 5000);
                }
            } else {
                // Nuevo pedido (ID generado)
                const cartCalc = calculateOrderPricing(orderItemsPayload, 0.10);
                finalGrandTotal = cartCalc.grandTotal;
                const randomCode = Math.floor(1000 + Math.random() * 9000);
                finalOrderId = `WEB-${randomCode}`;
                finalOrderPayload = orderItemsPayload;
                const timestamp = Date.now();

                const webOrderDocument = {
                    id: timestamp,
                    webOrderId: finalOrderId,
                    origin: origin,
                    tableNumber: origin,
                    customerName: customerName,
                    customerPhone: customerPhone,
                    deliveryAddress: customerAddress,
                    gpsMapLink: mapLink,
                    writtenAddress: writtenAddress,
                    orderFlow: currentOrderFlow,
                    fcmToken: clientFcmToken || localStorage.getItem('fcm_client_token') || null,
                    itemsJson: JSON.stringify(orderItemsPayload),
                    totalAmount: finalGrandTotal,
                    status: isCurrentlyOffline ? "Pendiente Sincronización (Offline)" : "Pendiente Validación",
                    paymentMethod: paymentMethod,
                    notes: notes,
                    isAdditional: false,
                    createdAt: timestamp
                };

                // Si es pedido por WhatsApp, disparar apertura de WhatsApp con el mensaje estructurado
                if (currentOrderFlow === 'whatsapp') {
                    const whatsappTargetPhone = (businessConfig.whatsappPhone || "50255551234").replace(/[^0-9]/g, '');
                    const itemsListText = orderItemsPayload.map(it => `• ${it.quantity}x ${it.name} (Q${Number(it.subtotal).toFixed(2)})${it.notes ? ` [${it.notes}]` : ''}`).join('%0A');
                    const gpsLine = mapLink ? `%0A📍 *Ubicación GPS (Maps/Waze):* ${encodeURIComponent(mapLink)}` : '';
                    const writtenAddrLine = `%0A🏠 *Ubicación 2 (Dirección y Ref):* ${encodeURIComponent(writtenAddress)}`;
                    const notesLine = notes ? `%0A📝 *Instrucciones:* ${encodeURIComponent(notes)}` : '';

                    const waMessage = `¡Hola Restaurante Rivera! 👋%0AAcabo de enviar el pedido *#${finalOrderId}* por la Web:%0A%0A👤 *Cliente:* ${encodeURIComponent(customerName)}%0A📱 *Teléfono:* ${encodeURIComponent(customerPhone)}${gpsLine}${writtenAddrLine}%0A%0A🛒 *DETALLE DEL PEDIDO:*%0A${itemsListText}${notesLine}%0A%0A💰 *Total:* Q${finalGrandTotal.toFixed(2)}%0A💳 *Forma de Pago:* ${encodeURIComponent(paymentMethod)}%0A%0A_Por favor confirmen la recepción y tiempo estimado de entrega._`;

                    const waUrl = `https://wa.me/${whatsappTargetPhone}?text=${waMessage}`;
                    window.open(waUrl, '_blank');
                }

                if (isCurrentlyOffline) {
                    addOrderToOfflineQueue(webOrderDocument, false, null);
                    saveOrderToHistory(webOrderDocument);
                    saveCustomerInfoToStorage(customerName, customerPhone, customerAddress);
                    launchConfettiBurst();
                    launchConfirmationBubbles(btnRect.left + btnRect.width / 2, btnRect.top + btnRect.height / 2);
                    playOrderStatusAudioChime('listo');
                    showOrderSuccessScreen(finalOrderId, customerName, origin, customerAddress, finalGrandTotal, orderItemsPayload, paymentMethod, notes, true);
                    cart = [];
                    updateCartUI();
                    showLiveToast("Pedido Guardado Offline", "Sin conexión. Tu pedido quedó guardado en cola y se sincronizará automáticamente al volver el internet.", "warning", 6000);
                    return;
                }

                try {
                    if (db) {
                        await withTimeout(db.collection("pedidos_web").doc(finalOrderId).set(webOrderDocument), 4000);
                        console.log("Nuevo pedido guardado con éxito en Firestore:", finalOrderId);
                    } else {
                        addOrderToOfflineQueue(webOrderDocument, false, null);
                    }
                    saveOrderToHistory(webOrderDocument);
                    saveCustomerInfoToStorage(customerName, customerPhone, customerAddress);
                    setupCustomerOrdersListener();
                    launchConfettiBurst();
                    launchConfirmationBubbles(btnRect.left + btnRect.width / 2, btnRect.top + btnRect.height / 2);
                    playOrderStatusAudioChime('listo');
                    showOrderSuccessScreen(finalOrderId, customerName, origin, customerAddress, finalGrandTotal, orderItemsPayload, paymentMethod, notes, false);
                    cart = [];
                    updateCartUI();
                } catch (netErr) {
                    console.warn("Fallo de red al enviar nuevo pedido, encolando en persistencia offline:", netErr);
                    webOrderDocument.status = "Pendiente Sincronización (Offline)";
                    addOrderToOfflineQueue(webOrderDocument, false, null);
                    saveOrderToHistory(webOrderDocument);
                    saveCustomerInfoToStorage(customerName, customerPhone, customerAddress);
                    launchConfettiBurst();
                    launchConfirmationBubbles(btnRect.left + btnRect.width / 2, btnRect.top + btnRect.height / 2);
                    playOrderStatusAudioChime('listo');
                    showOrderSuccessScreen(finalOrderId, customerName, origin, customerAddress, finalGrandTotal, orderItemsPayload, paymentMethod, notes, true);
                    cart = [];
                    updateCartUI();
                    showLiveToast("Guardado en Cola Offline", "Se interrumpió la red. Tu pedido está seguro y se enviará al reconectar.", "warning", 5000);
                }
            }
        }
        function showOrderSuccessScreen(orderId, name, table, address, total, items, paymentMethod, generalNotes, isOfflineQueued = false) {
            const modalBody = document.getElementById('modalBody');
            const modalFooter = document.getElementById('modalFooter');

            currentOrderStartTime = Date.now();

            const itemsSummaryText = items.map(i => {
                let str = `• ${i.quantity}x ${i.name} (Q${i.subtotal.toFixed(2)})`;
                if (i.notes) str += ` [Nota: ${i.notes}]`;
                return str;
            }).join('%0A');

            const addressSnippet = address ? `%0A*Dirección:* ${encodeURIComponent(address)}` : '';
            const notesSnippet = generalNotes ? `%0A*Notas:* ${encodeURIComponent(generalNotes)}` : '';
            const whatsappText = `¡Hola! Acabo de realizar el pedido *#${orderId}* en Restaurante Rivera:%0A%0A*Cliente:* ${encodeURIComponent(name)}%0A*Ubicación:* ${encodeURIComponent(table)}${addressSnippet}%0A*Detalle:*%0A${itemsSummaryText}${notesSnippet}%0A%0A*Total con propina:* Q${total.toFixed(2)}%0A*Pago:* ${encodeURIComponent(paymentMethod)}%0A%0A_Por favor confirmen la recepción en cocina._`;
            const whatsappTargetPhone = (businessConfig.whatsappPhone || '50255551234').replace(/[^0-9]/g, '');
            const whatsappLink = `https://wa.me/${whatsappTargetPhone}?text=${whatsappText}`;

            const itemsDetailedHtml = items.map(it => `
                <div style="display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 13px;">
                    <div>
                        <span><strong>${it.quantity}x</strong> ${escapeHtml(it.name)}</span>
                        ${it.notes ? `<div style="font-size: 11px; color: #64748B; margin-left: 14px;">✍️ ${escapeHtml(it.notes)}</div>` : ''}
                    </div>
                    <span style="font-weight: 700; color: var(--text-main);">Q${Number(it.subtotal).toFixed(2)}</span>
                </div>
            `).join('');

            const pointsEarned = Math.floor(total / 0.50);
            const estMinutes = estimatedWaitMinutes || 15;

            modalBody.innerHTML = `
                <div class="success-card">
                    <div class="success-icon-box" style="${isOfflineQueued ? 'background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%); box-shadow: 0 4px 14px rgba(217, 119, 6, 0.4);' : ''}">${isOfflineQueued ? '📡' : '✓'}</div>
                    <h3 style="font-size: 20px; font-weight: 800; color: var(--text-main);">${isOfflineQueued ? '¡Pedido Guardado en Cola Offline!' : '¡Pedido Recibido con Éxito!'}</h3>
                    <p style="font-size: 14px; color: var(--text-muted);">${isOfflineQueued ? 'Sin señal de internet. Tu orden está guardada de forma segura en este dispositivo y se enviará automáticamente a cocina al recuperar conexión.' : 'Tu orden ha sido enviada al sistema del restaurante.'}</p>
                    
                    <!-- Real-Time Elapsed Wait Time Tracker -->
                    <div class="elapsed-time-tracker-card" id="elapsedWaitTimeCard">
                        <div class="elapsed-header">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span class="elapsed-pulse-dot"></span>
                                <div>
                                    <h4 class="elapsed-title">Tiempo Transcurrido</h4>
                                    <p class="elapsed-sub">Monitoreo de preparación en tiempo real</p>
                                </div>
                            </div>
                            <span class="elapsed-badge" id="elapsedWaitTimerBadge">00m 00s</span>
                        </div>

                        <div class="elapsed-timer-display" id="elapsedTimerLargeDisplay">
                            0 min 0 seg
                        </div>

                        <div class="elapsed-progress-track">
                            <div class="elapsed-progress-fill" id="elapsedProgressFill" style="width: 2%;"></div>
                        </div>

                        <div class="elapsed-status-note" id="elapsedStatusNote">
                            <span>👨‍🍳</span>
                            <span id="elapsedStatusNoteText">Comanda recibida. Tu orden está en cola de cocina (Tiempo est. ~${estMinutes} min).</span>
                        </div>
                    </div>

                    <div style="background: #F8FAFC; border: 1px solid var(--border-color); border-radius: 12px; padding: 14px; width: 100%;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                            <div>
                                <div style="font-size: 12px; color: var(--text-muted);">Número de Orden:</div>
                                <div style="font-size: 22px; font-weight: 800; color: var(--primary-color);">${orderId}</div>
                            </div>
                            <span class="order-loyalty-badge" style="font-size: 12px; padding: 4px 10px;">
                                <span>⭐</span>
                                <span>+${pointsEarned} Puntos Rivera</span>
                            </span>
                        </div>

                        <div style="margin-top: 8px;">
                            ${isOfflineQueued ? `
                                <span class="badge-status-offline">📡 Guardado en Cola Local (Pendiente de Sincronizar)</span>
                            ` : `
                                <span class="badge-status-pending">⏳ Pendiente Validación</span>
                            `}
                        </div>
                        <div style="margin-top: 10px; font-size: 13px; color: var(--text-muted);">
                            <strong>${escapeHtml(table)}</strong> ${address ? `• ${escapeHtml(address)}` : ''} • Total: <strong>Q${total.toFixed(2)}</strong>
                        </div>
                        
                        <div style="margin-top: 12px; border-top: 1px dashed var(--border-color); padding-top: 10px; text-align: left;">
                            ${itemsDetailedHtml}
                            ${generalNotes ? `<div style="font-size: 12px; color: var(--primary-dark); margin-top: 6px; background: rgba(13,148,136,0.08); padding: 6px 8px; border-radius: 6px;">📝 <em>${escapeHtml(generalNotes)}</em></div>` : ''}
                        </div>
                    </div>

                    <div style="background: ${isOfflineQueued ? '#FFFBEB' : '#EFF6FF'}; border: 1px solid ${isOfflineQueued ? '#FCD34D' : '#BFDBFE'}; border-radius: 10px; padding: 10px; font-size: 12px; color: ${isOfflineQueued ? '#92400E' : '#1E40AF'}; text-align: left; display: flex; align-items: center; gap: 8px; width: 100%;">
                        <span style="font-size: 16px;">${isOfflineQueued ? '🔄' : '🔔'}</span>
                        <span>${isOfflineQueued ? '<strong>Cola offline activa:</strong> No necesitas volver a pedir. La orden se sincronizará automáticamente cuando vuelva el internet.' : 'Te notificaremos en tu pantalla con sonido y alerta en cuanto tu pedido esté <strong>Listo</strong> o <strong>Entregado</strong>.'}</span>
                    </div>

                    <p style="font-size: 12px; color: var(--text-muted);">
                        El mesero o cocina validará tu orden en segundos. También puedes descargar tu recibo PDF o compartirlo por WhatsApp:
                    </p>

                    <div style="display: flex; gap: 8px; width: 100%; flex-wrap: wrap;">
                        ${isOfflineQueued ? `
                            <button type="button" class="btn-download-receipt" style="flex: 1; min-width: 140px; padding: 10px; justify-content: center; font-size: 13px; background: #FFF7ED; color: #C2410C; border-color: #FDBA74; font-weight: 800;" onclick="syncPendingOfflineOrders(true)">
                                <span>🔄 Sincronizar Ahora</span>
                            </button>
                        ` : ''}
                        <button type="button" class="btn-download-receipt" style="flex: 1; min-width: 130px; padding: 10px; justify-content: center; font-size: 13px;" onclick="downloadPdfReceipt('${orderId}')">
                            <span>📄 Recibo PDF</span>
                        </button>
                        <a href="${whatsappLink}" target="_blank" class="btn-whatsapp-share" style="flex: 1; min-width: 120px; margin: 0; padding: 10px; justify-content: center; font-size: 13px;">
                            <span>💬 WhatsApp</span>
                        </a>
                    </div>
                </div>
            `;

            modalFooter.innerHTML = `
                <button class="btn-confirm-order" onclick="clearInterval(orderWaitTimerInterval); closeCartModal(); location.reload();">
                    <span>Hacer Otro Pedido</span>
                </button>
            `;

            // Start dynamic elapsed wait time interval (1 second tick)
            if (orderWaitTimerInterval) clearInterval(orderWaitTimerInterval);
            updateElapsedWaitTimer();
            orderWaitTimerInterval = setInterval(updateElapsedWaitTimer, 1000);
        }

        function updateElapsedWaitTimer() {
            if (!currentOrderStartTime) return;
            const now = Date.now();
            const elapsedSec = Math.floor((now - currentOrderStartTime) / 1000);
            const minutes = Math.floor(elapsedSec / 60);
            const seconds = elapsedSec % 60;

            const badgeEl = document.getElementById('elapsedWaitTimerBadge');
            const displayEl = document.getElementById('elapsedTimerLargeDisplay');
            const progressEl = document.getElementById('elapsedProgressFill');
            const noteTextEl = document.getElementById('elapsedStatusNoteText');

            const formattedBadge = `${String(minutes).padStart(2, '0')}m ${String(seconds).padStart(2, '0')}s`;
            const formattedDisplay = minutes > 0 ? `${minutes} min ${seconds} seg` : `${seconds} seg`;

            if (badgeEl) badgeEl.textContent = formattedBadge;
            if (displayEl) displayEl.textContent = formattedDisplay;

            const estMinutes = estimatedWaitMinutes || 15;
            const estTotalSeconds = estMinutes * 60;
            const progressPercent = Math.min(96, Math.max(3, Math.round((elapsedSec / estTotalSeconds) * 100)));

            if (progressEl) progressEl.style.width = `${progressPercent}%`;

            if (noteTextEl) {
                if (elapsedSec < 90) {
                    noteTextEl.textContent = `Comanda recibida. Tu orden está en cola de cocina (Tiempo est. ~${estMinutes} min).`;
                } else if (elapsedSec < 360) {
                    noteTextEl.textContent = `Platillos en preparación activa con ingredientes frescos al momento.`;
                } else if (elapsedSec < 600) {
                    noteTextEl.textContent = `Cocción en punto óptimo y control de calidad gastronómica.`;
                } else if (elapsedSec < estTotalSeconds) {
                    noteTextEl.textContent = `Montaje, empaque final y aderezos listos para entrega inmediata.`;
                } else {
                    noteTextEl.textContent = `¡Tu orden está a punto de salir a tu mesa o entrega! 🍽️`;
                }
            }
        }

        // --- 14. TABLE QR SCANNER & SWITCHER SYSTEM ---
        let qrVideoStream = null;
        let qrScanAnimationId = null;
        const AVAILABLE_TABLES = [
            "Mesa 1", "Mesa 2", "Mesa 3", "Mesa 4", "Mesa 5", "Mesa 6", 
            "Mesa 7", "Mesa 8", "Barra Principal", "Terraza 1", "Terraza 2", 
            "VIP Salón", "Para Llevar / Pick-Up", "A Domicilio"
        ];

        function initTableQuickGrid() {
            const grid = document.getElementById('tableQuickGrid');
            if (!grid) return;

            const currentTable = document.getElementById('selectOrigin')?.value || 'Mesa 1';
            const modalLbl = document.getElementById('lblCurrentTableInModal');
            if (modalLbl) modalLbl.textContent = currentTable;

            grid.innerHTML = AVAILABLE_TABLES.map(tbl => {
                const isActive = tbl.toLowerCase() === currentTable.toLowerCase();
                let icon = "🪑";
                if (tbl.includes("Barra")) icon = "🍸";
                else if (tbl.includes("Terraza")) icon = "🌿";
                else if (tbl.includes("VIP")) icon = "✨";
                else if (tbl.includes("Llevar")) icon = "🛍️";
                else if (tbl.includes("Domicilio")) icon = "🛵";

                return `
                    <button type="button" class="table-chip-btn ${isActive ? 'active' : ''}" onclick="applyTableChange('${tbl}')">
                        <span>${icon}</span>
                        <span>${tbl}</span>
                    </button>
                `;
            }).join('');
        }

        function openTableQrScannerModal() {
            const modal = document.getElementById('tableQrScannerModal');
            if (!modal) return;
            modal.classList.add('active');
            initTableQuickGrid();
            startQrCameraScanner();
        }

        function closeTableQrScannerModal() {
            const modal = document.getElementById('tableQrScannerModal');
            if (modal) modal.classList.remove('active');
            stopQrCameraScanner();
        }

        function applyTableChange(tableStr, notify = true) {
            if (!tableStr) return;
            const select = document.getElementById('selectOrigin');
            const label = document.getElementById('tableLabel');
            const modalLbl = document.getElementById('lblCurrentTableInModal');
            const selectFlow = document.getElementById('selectFlowTableNumber');
            const displayFlow = document.getElementById('flowTableDisplayNum');

            if (label) label.textContent = tableStr;
            if (modalLbl) modalLbl.textContent = tableStr;
            if (displayFlow) displayFlow.textContent = tableStr;

            if (selectFlow) {
                let found = false;
                for (let i = 0; i < selectFlow.options.length; i++) {
                    if (selectFlow.options[i].value.toLowerCase() === tableStr.toLowerCase()) {
                        selectFlow.selectedIndex = i;
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    const newOpt = new Option(tableStr, tableStr, true, true);
                    selectFlow.add(newOpt, 0);
                }
            }

            if (select) {
                let found = false;
                for (let i = 0; i < select.options.length; i++) {
                    if (select.options[i].value.toLowerCase() === tableStr.toLowerCase()) {
                        select.selectedIndex = i;
                        found = true;
                        break;
                    }
                }
                if (!found) {
                    const newOpt = new Option(tableStr, tableStr, true, true);
                    select.add(newOpt, 0);
                }
                handleOriginChange();
            }

            try {
                localStorage.setItem('restaurante_selected_table', tableStr);
            } catch(e){}

            updateScheduleStatus();
            initTableQuickGrid();

            if (notify) {
                playOrderStatusAudioChime('listo');
                showLiveToast(
                    "📍 Mesa Actualizada",
                    `Tu ubicación se cambió a: <strong>${escapeHtml(tableStr)}</strong>`,
                    "success",
                    3500
                );
            }

            closeTableQrScannerModal();
        }

        async function startQrCameraScanner() {
            const video = document.getElementById('qrCameraVideo');
            const fallback = document.getElementById('qrCameraFallbackNotice');
            if (!video) return;

            try {
                if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                    qrVideoStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: "environment" }
                    });
                    video.srcObject = qrVideoStream;
                    video.play();
                    if (fallback) fallback.style.display = 'none';

                    // Start scanning frames if BarcodeDetector is available
                    if ('BarcodeDetector' in window) {
                        const barcodeDetector = new BarcodeDetector({ formats: ['qr_code'] });
                        
                        function detectFrame() {
                            if (!qrVideoStream) return;
                            barcodeDetector.detect(video).then(barcodes => {
                                if (barcodes.length > 0) {
                                    const rawValue = barcodes[0].rawValue || "";
                                    handleScannedQrResult(rawValue);
                                } else {
                                    qrScanAnimationId = requestAnimationFrame(detectFrame);
                                }
                            }).catch(() => {
                                qrScanAnimationId = requestAnimationFrame(detectFrame);
                            });
                        }
                        detectFrame();
                    }
                } else {
                    if (fallback) fallback.style.display = 'flex';
                }
            } catch (err) {
                console.warn("Camera access denied or unavailable in WebView:", err);
                if (fallback) fallback.style.display = 'flex';
            }
        }

        function stopQrCameraScanner() {
            if (qrScanAnimationId) {
                cancelAnimationFrame(qrScanAnimationId);
                qrScanAnimationId = null;
            }
            if (qrVideoStream) {
                qrVideoStream.getTracks().forEach(track => track.stop());
                qrVideoStream = null;
            }
            const video = document.getElementById('qrCameraVideo');
            if (video) video.srcObject = null;
        }

        function handleScannedQrResult(qrText) {
            if (!qrText) return;
            console.log("Código QR detectado:", qrText);

            let detectedTable = "";
            try {
                if (qrText.includes("mesa=") || qrText.includes("table=")) {
                    const parsedUrl = new URL(qrText.startsWith('http') ? qrText : `http://dummy.com/${qrText}`);
                    const val = parsedUrl.searchParams.get('mesa') || parsedUrl.searchParams.get('table');
                    if (val) detectedTable = val.toLowerCase().startsWith('mesa') ? val : `Mesa ${val}`;
                } else if (qrText.toLowerCase().includes("mesa")) {
                    detectedTable = qrText.trim();
                } else if (/^\d+$/.test(qrText.trim())) {
                    detectedTable = `Mesa ${qrText.trim()}`;
                }
            } catch(e) {
                if (qrText.toLowerCase().includes("mesa")) detectedTable = qrText.trim();
            }

            if (detectedTable) {
                applyTableChange(detectedTable, true);
            } else {
                showLiveToast("QR Leído", `Información detectada: ${qrText}`, "info");
            }
        }

        // --- 15. CUSTOMER EXPERIENCE FEEDBACK MODAL (Delivered Order Rating) ---
        let currentFeedbackOrderId = "";
        let selectedStarRating = 5;
        let selectedFeedbackChips = new Set(["🌮 Sabor delicioso", "⚡ Entrega rápida"]);

        function showCustomerFeedbackModal(orderId, customerName = "") {
            currentFeedbackOrderId = orderId || "WEB-1001";
            const modal = document.getElementById('orderFeedbackModal');
            const lbl = document.getElementById('feedbackModalOrderId');
            if (lbl) lbl.textContent = `#${currentFeedbackOrderId}`;

            // Check if already rated locally
            const isAlreadyRated = localStorage.getItem(`feedback_submitted_${currentFeedbackOrderId}`);
            if (isAlreadyRated) {
                console.log("Order already received feedback:", currentFeedbackOrderId);
                return;
            }

            if (modal) {
                modal.classList.add('active');
                selectFeedbackRating(5);
            }
        }

        function closeFeedbackModal() {
            const modal = document.getElementById('orderFeedbackModal');
            if (modal) modal.classList.remove('active');
        }

        function selectFeedbackRating(rating) {
            selectedStarRating = rating;
            const stars = document.querySelectorAll('#starRatingContainer .star-btn');
            const label = document.getElementById('starRatingLabel');

            stars.forEach(s => {
                const starVal = Number(s.getAttribute('data-rating') || 0);
                if (starVal <= rating) {
                    s.classList.add('active');
                } else {
                    s.classList.remove('active');
                }
            });

            const labelsMap = {
                1: "⭐ Muy deficiente - Lamentamos no cumplir tus expectativas",
                2: "⭐⭐ Regular - Trabajaremos para mejorar",
                3: "⭐⭐⭐ Bueno - Aceptable y agradable",
                4: "⭐⭐⭐⭐ ¡Muy Bueno! - Gran sabor y atención",
                5: "⭐⭐⭐⭐⭐ ¡Excelente! - ¡Experiencia gastronómica insuperable!"
            };

            if (label) label.textContent = labelsMap[rating] || "Toca una estrella para calificar";
        }

        function toggleFeedbackChip(chipEl) {
            if (!chipEl) return;
            const text = chipEl.textContent.trim();
            if (selectedFeedbackChips.has(text)) {
                selectedFeedbackChips.delete(text);
                chipEl.classList.remove('active');
            } else {
                selectedFeedbackChips.add(text);
                chipEl.classList.add('active');
            }
        }

        async function submitCustomerFeedback() {
            const comment = document.getElementById('feedbackCommentInput')?.value.trim() || "";
            const btn = document.getElementById('btnSubmitFeedback');

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = `<span>Enviando...</span>`;
            }

            const feedbackData = {
                orderId: currentFeedbackOrderId,
                rating: selectedStarRating,
                tags: Array.from(selectedFeedbackChips),
                comment: comment,
                createdAt: Date.now(),
                customerName: document.getElementById('inputCustomerName')?.value.trim() || "Cliente Rivera",
                customerPhone: document.getElementById('inputCustomerPhone')?.value.trim() || ""
            };

            try {
                if (db) {
                    await db.collection("calificaciones_pedidos").add(feedbackData);
                }
                localStorage.setItem(`feedback_submitted_${currentFeedbackOrderId}`, JSON.stringify(feedbackData));
                launchConfettiBurst();
                playOrderStatusAudioChime('listo');
                closeFeedbackModal();
                showLiveToast(
                    "⭐ ¡Gracias por tu Opinión!",
                    "Tu calificación nos ayuda a brindarte siempre la mejor experiencia en Restaurante Rivera.",
                    "success",
                    4500
                );
            } catch (err) {
                console.warn("Feedback save error:", err);
                localStorage.setItem(`feedback_submitted_${currentFeedbackOrderId}`, JSON.stringify(feedbackData));
                closeFeedbackModal();
                showLiveToast("⭐ ¡Gracias!", "Tu opinión ha sido registrada localmente.", "success", 4000);
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = `⭐ Enviar Opinión`;
                }
            }
        }

        // --- 16. NETWORK CONNECTIVITY & OFFLINE PERSISTENCE HANDLERS ---
        function updateOfflineQueueUI(isSyncing = false) {
            const banner = document.getElementById('offlineBanner');
            const icon = document.getElementById('offlineBannerIcon');
            const text = document.getElementById('offlineBannerText');
            if (!banner || !icon || !text) return;

            const queue = getOfflineOrdersQueue();
            const queueCount = queue.length;

            if (isSyncing) {
                banner.style.display = 'flex';
                banner.classList.remove('is-online');
                banner.style.background = 'linear-gradient(135deg, #1E3A8A 0%, #0D9488 100%)';
                banner.style.borderBottomColor = '#38BDF8';
                icon.textContent = '🔄';
                text.innerHTML = `<span>Sincronizando <strong>${queueCount} pedido(s)</strong> pendiente(s) con la cocina...</span>`;
                return;
            }

            if (!navigator.onLine) {
                banner.classList.remove('is-online');
                banner.style.display = 'flex';
                banner.style.background = 'linear-gradient(135deg, #475569 0%, #1E293B 100%)';
                banner.style.borderBottomColor = '#F59E0B';
                icon.textContent = '📡';
                if (queueCount > 0) {
                    text.innerHTML = `<span>Modo Offline Activo: <strong>${queueCount} pedido(s)</strong> en cola local guardados en este dispositivo. Se enviarán al recuperar la señal.</span> <button type="button" class="btn-sync-queue" onclick="syncPendingOfflineOrders(true)">🔄 Reintentar</button>`;
                } else {
                    text.innerHTML = '<span>Sin conexión a internet: Modo Offline activo. El menú y tu historial están disponibles en tu dispositivo.</span>';
                }
            } else {
                if (queueCount > 0) {
                    banner.style.display = 'flex';
                    banner.classList.remove('is-online');
                    banner.style.background = 'linear-gradient(135deg, #D97706 0%, #B45309 100%)';
                    banner.style.borderBottomColor = '#FDE68A';
                    icon.textContent = '⚠️';
                    text.innerHTML = `<span>Tienes <strong>${queueCount} pedido(s) guardado(s) offline</strong> pendiente(s) de enviar.</span> <button type="button" class="btn-sync-queue" style="background: white; color: #B45309;" onclick="syncPendingOfflineOrders(true)">🚀 Sincronizar Ahora</button>`;
                } else {
                    banner.classList.add('is-online');
                    banner.style.background = '#15803D';
                    banner.style.borderBottomColor = '#4ADE80';
                    icon.textContent = '🟢';
                    text.innerHTML = '<span>¡Conexión activa! Menú y pedidos sincronizados en tiempo real.</span>';
                    setTimeout(() => {
                        if (navigator.onLine && getOfflineOrdersQueue().length === 0) {
                            banner.style.display = 'none';
                        }
                    }, 3500);
                }
            }
        }

        function updateOnlineStatusUI() {
            if (navigator.onLine) {
                updateOfflineQueueUI();
                syncPendingOfflineOrders();
            } else {
                updateOfflineQueueUI();
                showLiveToast("Modo Offline", "Sin conexión. Puedes continuar ordenando y tus pedidos se guardarán en cola local.", "info", 5000);
            }
        }

        window.addEventListener('online', () => {
            updateOnlineStatusUI();
            syncPendingOfflineOrders();
        });
        window.addEventListener('offline', updateOnlineStatusUI);

        // --- 17. INITIAL RUN & INTERVAL CHECKS ---
        window.addEventListener('DOMContentLoaded', () => {
            loadBusinessConfig();
            loadCachedMenuProducts();
            parseUrlParams();
            loadSavedCustomerInfo();
            applyTheme(currentTheme);
            renderCategories();
            renderProducts();
            initPredictiveSearch();
            initVoiceSearch();
            initFormValidationListeners();
            initClientFCM();
            updateScheduleStatus();
            updateOrderHistoryBadge();
            setupFirestoreListeners();
            setupCustomerOrdersListener();
            initTableQuickGrid();

            // Register Service Worker for offline asset & menu caching
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('firebase-messaging-sw.js').then((reg) => {
                    console.log('App Service Worker registrado para modo Offline & FCM:', reg.scope);
                }).catch((err) => {
                    console.warn('Error registrando Service Worker:', err);
                });
            }

            updateOfflineQueueUI();
            if (navigator.onLine) {
                setTimeout(() => {
                    syncPendingOfflineOrders();
                }, 1200);
            }

            // Periodic schedule checker every minute
            setInterval(updateScheduleStatus, 60000);

            // Periodic offline orders queue sync check every 15 seconds
            setInterval(() => {
                if (navigator.onLine && getOfflineOrdersQueue().length > 0) {
                    syncPendingOfflineOrders();
                }
            }, 15000);
        });
    </script>

    <!-- Mobile Bottom Navigation Bar -->
    <nav class="app-bottom-nav-bar" id="appBottomNavBar">
        <button type="button" class="bottom-nav-item active" id="bnavMenu" onclick="switchAppView('menu')" title="Menú de Platillos">
            <span class="bnav-icon">🍽️</span>
            <span class="bnav-text">Menú</span>
        </button>
        <button type="button" class="bottom-nav-item" id="bnavCustomization" onclick="switchAppView('customization')" title="Personalización Web">
            <span class="bnav-icon">🎨</span>
            <span class="bnav-text">Diseño</span>
        </button>
        <button type="button" class="bottom-nav-item" id="bnavSchedule" onclick="switchAppView('schedule')" title="Horario y Estado">
            <span class="bnav-icon">🕒</span>
            <span class="bnav-text">Horario</span>
            <span class="bnav-dot open" id="bnavScheduleDot"></span>
        </button>
        <button type="button" class="bottom-nav-item" id="bnavInvoicing" onclick="switchAppView('invoicing')" title="Facturación">
            <span class="bnav-icon">🧾</span>
            <span class="bnav-text">Factura</span>
        </button>
        <button type="button" class="bottom-nav-item" id="bnavCart" onclick="openCartModal()" title="Mi Pedido">
            <span class="bnav-icon">🛒</span>
            <span class="bnav-text">Pedido</span>
            <span class="bnav-badge" id="bnavCartBadge" style="display: none;">0</span>
        </button>
        <button type="button" class="bottom-nav-item" id="bnavManager" onclick="openManagerModal('customization')" title="Ajustes de Gerencia">
            <span class="bnav-icon">⚙️</span>
            <span class="bnav-text">Gerencia</span>
        </button>
    </nav>
</body>
</html>
