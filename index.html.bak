            if (!businessConfig.bannerTag) businessConfig.bannerTag = "Especial de la Casa";
            if (!businessConfig.bannerTitle) businessConfig.bannerTitle = "Auténtica Gastronomía";
            if (!businessConfig.bannerWelcome) businessConfig.bannerWelcome = "Bienvenidos. Selecciona tus platillos y bebidas favoritas para enviar tu pedido directamente a la cocina.";
            if (!businessConfig.themePrimaryColor) businessConfig.themePrimaryColor = "#10B981";

            if (!businessConfig.billingBusinessName) businessConfig.billingBusinessName = "Restaurante Rivera";
            if (!businessConfig.billingTaxId) businessConfig.billingTaxId = "10594832-7";
            if (!businessConfig.billingAddress) businessConfig.billingAddress = "Calle Principal #10, Zona Central";
            if (!businessConfig.billingPhone) businessConfig.billingPhone = "50255551234";
            if (!businessConfig.billingEmail) businessConfig.billingEmail = "riverahotel01@gmail.com";
            if (businessConfig.billingTaxRate === undefined) businessConfig.billingTaxRate = 12;
            if (businessConfig.billingAskClientForTaxData === undefined) businessConfig.billingAskClientForTaxData = true;
            if (businessConfig.billingIncludeInWhatsapp === undefined) businessConfig.billingIncludeInWhatsapp = true;
            if (!businessConfig.billingTipOption) businessConfig.billingTipOption = "10";
            if (!businessConfig.billingPaymentMethods) businessConfig.billingPaymentMethods = "Efectivo, Tarjeta POS, Transferencia";

            applyBrandCustomizationLive();
        }

