            const bannerTitle = document.getElementById('themeTitle');
            if (bannerTitle && businessConfig.bannerTitle) bannerTitle.textContent = businessConfig.bannerTitle;

            const bannerWelcome = document.getElementById('themeWelcome');
            if (bannerWelcome && businessConfig.bannerWelcome) bannerWelcome.textContent = businessConfig.bannerWelcome;

            if (businessConfig.themePrimaryColor) {
                document.documentElement.style.setProperty('--primary-color', businessConfig.themePrimaryColor);
